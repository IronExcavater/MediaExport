<?xml version="1.0" encoding="utf-8"?>
<local:MediaViewBase
    x:Class="MediaExport.Media.Controls.CompactMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls">

    <Grid Padding="0,6" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Width="{x:Bind ThumbnailWidth, Mode=OneTime}"
            Height="56"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="4">
            <Image Source="{x:Bind ThumbnailSource, Mode=OneTime}" Stretch="UniformToFill" />
            <Border
                Margin="4"
                Padding="4,3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="2"
                Opacity="0.9"
                Visibility="{x:Bind DurationVisibility, Mode=OneTime}">
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind DurationText, Mode=OneTime}"
                    TextLineBounds="Tight" />
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                MaxLines="2"
                Text="{x:Bind TitleText, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind BylineText, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind MetaDetail, Mode=OneTime}" />
        </StackPanel>
    </Grid>
</local:MediaViewBase>
