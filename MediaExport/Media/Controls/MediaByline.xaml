<?xml version="1.0" encoding="utf-8"?>
<local:MediaView
    x:Class="MediaExport.Media.Controls.MediaByline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Media.Controls">

    <UserControl.Resources>
        <Style x:Key="BylineTextStyle" BasedOn="{StaticResource SecondaryTextStyle}" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <!-- The left-aligned grid is only as wide as its content, so the creator's name is what gets cut short. -->
    <Grid HorizontalAlignment="Left" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:IconView
            Width="14"
            Height="14"
            Icon="{x:Bind ProviderIcon(Media.ProviderId), Mode=OneWay}" />

        <TextBlock
            Grid.Column="1"
            Style="{StaticResource BylineTextStyle}"
            Text="{x:Bind Media.Creator, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />

        <!-- A dot shows only between two values (see OnMediaChanged). FallbackValue covers a null value. -->
        <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="6">
            <TextBlock
                x:Name="viewsSeparator"
                Style="{StaticResource BylineTextStyle}"
                Text="·" />
            <TextBlock
                x:Name="viewsText"
                Style="{StaticResource BylineTextStyle}"
                Text="{x:Bind converters:Format.Views(Media.Views), Mode=OneWay, FallbackValue=''}" />
            <TextBlock
                x:Name="ageSeparator"
                Style="{StaticResource BylineTextStyle}"
                Text="·" />
            <TextBlock
                x:Name="ageText"
                Style="{StaticResource BylineTextStyle}"
                Text="{x:Bind converters:Format.Age(Media.Published), Mode=OneWay, FallbackValue=''}" />
        </StackPanel>
    </Grid>
</local:MediaView>
