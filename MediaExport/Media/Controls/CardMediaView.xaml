<?xml version="1.0" encoding="utf-8"?>
<local:MediaView
    x:Class="MediaExport.Media.Controls.CardMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls">

    <StackPanel Spacing="8">
        <!-- With no media, the view is a skeleton of itself. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Loaded" />
                <VisualState x:Name="Skeleton">
                    <VisualState.Setters>
                        <Setter Target="words.Visibility" Value="Collapsed" />
                        <Setter Target="skeleton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <local:MediaThumbnail x:Name="thumbnail" Media="{x:Bind Media, Mode=OneWay}" />

        <!--
            Each bar is as tall, with its margins, as the line of text it stands in for: two lines of title and a
            byline, which is what most cards have.
        -->
        <StackPanel x:Name="skeleton" Visibility="Collapsed">
            <Border
                Height="14"
                Margin="0,3,24,3"
                HorizontalAlignment="Stretch"
                Style="{StaticResource SkeletonBarStyle}" />
            <Border
                Height="14"
                Margin="0,3,72,3"
                HorizontalAlignment="Stretch"
                Style="{StaticResource SkeletonBarStyle}" />
            <Border
                Width="140"
                Height="10"
                Margin="0,5,0,3"
                Style="{StaticResource SkeletonBarStyle}" />
        </StackPanel>

        <StackPanel x:Name="words" Spacing="2">
            <TextBlock
                IsTextSelectionEnabled="True"
                MaxLines="2"
                Text="{x:Bind Media.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <local:MediaByline Media="{x:Bind Media, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</local:MediaView>
