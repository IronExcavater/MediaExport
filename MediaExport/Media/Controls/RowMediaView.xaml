<?xml version="1.0" encoding="utf-8"?>
<local:MediaView
    x:Class="MediaExport.Media.Controls.RowMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Media.Controls">

    <Grid Padding="0,6" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:MediaThumbnail Height="56" Media="{x:Bind Media, Mode=OneWay}" />

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                MaxLines="2"
                Text="{x:Bind Media.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconView
                    Width="14"
                    Height="14"
                    Icon="{x:Bind ProviderIcon(Media.ProviderId), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind converters:Format.Byline(Media.Creator, Media.Views, Media.Published), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </StackPanel>
    </Grid>
</local:MediaView>
