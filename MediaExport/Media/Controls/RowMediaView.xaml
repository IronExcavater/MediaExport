<?xml version="1.0" encoding="utf-8"?>
<local:MediaView
    x:Class="MediaExport.Media.Controls.RowMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls">

    <Grid Padding="{x:Bind ContentPadding, Mode=OneWay}" ColumnSpacing="{x:Bind ContentSpacing, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- With no media, the view is a skeleton of itself. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="ContentLoaded" />
                <VisualState x:Name="Skeleton">
                    <VisualState.Setters>
                        <Setter Target="words.Visibility" Value="Collapsed" />
                        <Setter Target="skeleton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <local:MediaThumbnail Height="{x:Bind ThumbnailHeight, Mode=OneWay}" Media="{x:Bind Media, Mode=OneWay}" />

        <!-- Each bar is as tall, with its margins, as the text it stands in for. -->
        <StackPanel
            x:Name="skeleton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2"
            Visibility="Collapsed">
            <Border
                Height="14"
                Margin="0,3,80,3"
                HorizontalAlignment="Stretch"
                Style="{StaticResource SkeletonBarStyle}" />
            <Border
                Width="140"
                Height="10"
                Margin="0,3"
                Style="{StaticResource SkeletonBarStyle}" />
        </StackPanel>

        <StackPanel
            x:Name="words"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                FontSize="{x:Bind TitleFontSize, Mode=OneWay}"
                MaxLines="2"
                Text="{x:Bind Media.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <local:MediaByline Media="{x:Bind Media, Mode=OneWay}" />
            <ContentPresenter Content="{x:Bind Details, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</local:MediaView>
