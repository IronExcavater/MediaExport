<?xml version="1.0" encoding="utf-8"?>
<local:MediaViewBase
    x:Class="MediaExport.Media.Controls.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls"
    Loaded="PlayerView_Loaded"
    Unloaded="PlayerView_Unloaded">

    <!-- The site's own player over the thumbnail, which shows while it loads or when it's hidden. -->
    <Grid
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill" />
        <WebView2 x:Name="player" WebMessageReceived="Player_WebMessageReceived" />
    </Grid>
</local:MediaViewBase>
