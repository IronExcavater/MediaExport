<?xml version="1.0" encoding="utf-8"?>
<local:MediaViewBase
    x:Class="MediaExport.Media.Controls.HeroMediaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls"
    Loaded="HeroMediaView_Loaded"
    Unloaded="HeroMediaView_Unloaded">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The provider's own player, loaded as soon as the media is shown. -->
        <Grid
            x:Name="stage"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="8"
            SizeChanged="Stage_SizeChanged">
            <Image Source="{x:Bind ThumbnailSource, Mode=OneTime}" Stretch="UniformToFill" />
            <WebView2 x:Name="player" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock
                MaxLines="2"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTipService.ToolTip="Open in browser">
                <Hyperlink
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    NavigateUri="{x:Bind SourceUri, Mode=OneTime}"
                    UnderlineStyle="None">
                    <Run Text="{x:Bind TitleText, Mode=OneTime}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Open creator page">
                <Hyperlink
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    NavigateUri="{x:Bind CreatorUri, Mode=OneTime}"
                    UnderlineStyle="None">
                    <Run Text="{x:Bind CreatorText, Mode=OneTime}" />
                </Hyperlink>
                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DurationSuffix, Mode=OneTime}" />
            </TextBlock>
        </StackPanel>
    </Grid>
</local:MediaViewBase>
