<?xml version="1.0" encoding="utf-8"?>
<local:MediaView
    x:Class="MediaExport.Media.Controls.MediaThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaExport.Media.Controls">

    <!-- The grid's background shows until the picture has loaded. The duration badge is hidden for media with no known duration. -->
    <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
        <Image x:Name="image" Stretch="UniformToFill" />
        <Border
            Margin="4"
            Padding="4,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="2"
            Opacity="0.9"
            Visibility="{x:Bind VisibleWith(Media.Duration), Mode=OneWay}">
            <TextBlock
                FontSize="11"
                Text="{x:Bind DurationText(Media.Duration), Mode=OneWay}"
                TextLineBounds="Tight" />
        </Border>
    </Grid>
</local:MediaView>
