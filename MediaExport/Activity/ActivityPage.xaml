<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:export="using:MediaExport.Export"
    xmlns:media="using:MediaExport.Media.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.RowSpan="2"
            MaxWidth="360"
            Margin="24,0,24,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{Binding HasJobs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}">
            <FontIcon
                Margin="0,0,0,12"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No exports yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Exports you start appear here, so you can follow their progress and find the files."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- List commands. Remove and Select all only make sense while selecting. -->
        <Grid
            MaxWidth="1240"
            Padding="24,12,16,0"
            Visibility="{Binding HasJobs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding ActivitySummary}" />
            <CommandBar
                Grid.Column="1"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarToggleButton
                    x:Name="selectToggle"
                    Checked="SelectToggle_Changed"
                    Label="Select"
                    Unchecked="SelectToggle_Changed">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE762;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    x:Name="selectAllButton"
                    Click="SelectAll_Click"
                    Label="Select all"
                    Visibility="Collapsed">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8B3;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="removeButton"
                    Click="Remove_Click"
                    IsEnabled="False"
                    Label="Remove"
                    Visibility="Collapsed">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{Binding ClearFinishedCommand}" Label="Clear finished">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE894;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ListView
            x:Name="jobList"
            Grid.Row="1"
            Padding="24,8,24,24"
            IsItemClickEnabled="True"
            ItemClick="JobList_ItemClick"
            ItemsSource="{Binding Jobs}"
            SelectionChanged="JobList_SelectionChanged"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="MaxWidth" Value="1192" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="export:ExportJob">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="80"
                                Height="45"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind Media.ThumbnailUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Media.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Summary}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{x:Bind Status, Mode=OneWay}" />
                                </TextBlock>
                                <ProgressBar
                                    Margin="0,4,0,0"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                    Visibility="{x:Bind ShowsProgress, Mode=OneWay}"
                                    Value="{x:Bind DisplayProgress, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    AutomationProperties.Name="Cancel"
                                    Command="{x:Bind CancelCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Cancel"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Open"
                                    Command="{x:Bind OpenCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Open"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Show in folder"
                                    Command="{x:Bind ShowInFolderCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Show in folder"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                            </StackPanel>

                            <FontIcon
                                Grid.Column="3"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" />
                        </Grid>

                        <!-- Loaded only when expanded, so the list doesn't host a web player per row. -->
                        <media:HeroMediaView
                            x:Name="hero"
                            Grid.Row="1"
                            x:Load="{x:Bind IsExpanded, Mode=OneWay}"
                            Media="{x:Bind Media}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
