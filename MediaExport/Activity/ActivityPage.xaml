<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Activity"
    xmlns:media="using:MediaExport.Media.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- The exports under their headings: what's exporting, what's up next, then by when they finished. -->
        <CollectionViewSource
            x:Name="groupedJobs"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups}" />
    </Page.Resources>

    <Grid>
        <StackPanel
            MaxWidth="420"
            Margin="24,0,24,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind converters:Show.Unless(ViewModel.HasJobs), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,8"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Nothing exported yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Exports show up here: the ones waiting, the ones running and the ones done."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="24,16,24,0"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    AutomationProperties.Name="Search your exports"
                    PlaceholderText="Search your exports"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="removeButton"
                        Click="Remove_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Remove the selected exports from this list. Their files stay where they are.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind jobList}" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearFinishedCommand}" ToolTipService.ToolTip="Remove every finished export from this list. Their files stay where they are.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE894;" />
                            <TextBlock Text="Clear finished" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="1"
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No exports match that."
                Visibility="{x:Bind converters:Show.Unless(ViewModel.HasMatches), Mode=OneWay}" />

            <!-- Cards side by side, as many as fit; their width is set in code so each row fills the page. -->
            <GridView
                x:Name="jobList"
                Grid.Row="1"
                Padding="0,0,0,24"
                DoubleTapped="JobList_DoubleTapped"
                ItemsSource="{x:Bind groupedJobs.View}"
                SelectionChanged="JobList_SelectionChanged"
                SelectionMode="Extended"
                SizeChanged="JobList_SizeChanged">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="96" Loaded="Cards_Loaded" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:JobGroup">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:ExportJob">
                        <Grid
                            Padding="12,10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ColumnSpacing="12"
                            CornerRadius="8">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind OpenCommand}" Text="Open">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ShowInFolderCommand}" Text="Show in folder">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="ExportAgain_Click" Tag="{x:Bind}" Text="Export again">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="CopyLink_Click" Tag="{x:Bind}" Text="Copy link">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="RemoveOne_Click" Tag="{x:Bind}" Text="Remove from list">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="{x:Bind media:MediaViewBase.WidthFor(Media.Kind, 63)}"
                                Height="63"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage DecodePixelWidth="224" UriSource="{x:Bind Media.ThumbnailUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <!-- What it was, how it was saved, and where it stands. -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Media.Title}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Media.Title}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Summary}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Status, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    AutomationProperties.Name="Cancel"
                                    Command="{x:Bind CancelCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Cancel"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Open"
                                    Command="{x:Bind OpenCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Open"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Show in folder"
                                    Command="{x:Bind ShowInFolderCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Show in folder"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                            </StackPanel>

                            <!-- Along the card's bottom edge, so progress doesn't make it taller. -->
                            <ProgressBar
                                Grid.ColumnSpan="3"
                                Margin="-8,0,-8,-9"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                Visibility="{x:Bind ShowsProgress, Mode=OneWay}"
                                Value="{x:Bind DisplayProgress, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
