<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Activity"
    xmlns:media="using:MediaExport.Media.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- The exports under their headings: what is exporting, what is up next, then by the day they finished. -->
        <CollectionViewSource
            x:Name="groupedJobs"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups}" />

        <!-- The icon that says how an export stands, at the start of its status. -->
        <Style x:Key="StateIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ActivityIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <!-- 12 less side padding and a 12 heading inset leave room for the rows' focus ring, as on the Search page. -->
    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,0,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitleStyle}" Text="Activity" />
            <Button
                Grid.Column="1"
                Click="SelectAll_Click"
                Content="Select all"
                Visibility="{x:Bind ViewModel.ShowSelectAll, Mode=OneWay}" />
            <Border
                Grid.Column="1"
                Padding="10,4,4,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" />
                    <Button Click="ClearSelection_Click" Content="Clear" Style="{StaticResource SubtleButtonStyle}" />
                    <Button Command="{x:Bind ViewModel.RemoveSelectedCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Remove" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <controls:EmptyStateView
            Title="No exports yet"
            Grid.Row="1"
            Glyph="&#xE81C;"
            Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.HasJobs), Mode=OneWay}">
            <controls:EmptyStateView.Action>
                <Button Click="Search_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource FieldIconStyle}" />
                        <TextBlock Text="Search for media" />
                    </StackPanel>
                </Button>
            </controls:EmptyStateView.Action>
        </controls:EmptyStateView>

        <controls:EdgeFade Grid.Row="1">
            <ListView
                x:Name="jobsList"
                Padding="0,0,0,24"
                controls:ScrollBarGutter.Mode="Auto"
                ItemsSource="{x:Bind groupedJobs.View}"
                SelectionChanged="JobsList_SelectionChanged"
                SelectionMode="Extended">
                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,14,12,6" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:JobGroup">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ExportJob">
                        <Grid ColumnSpacing="16" Padding="4,2">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OpenFile_Click" Tag="{x:Bind}" Text="Open file" Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                    <MenuFlyoutItem Command="{x:Bind ShowInFolderCommand}" Text="Show in folder" Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                    <MenuFlyoutItem Click="Open_Click" Tag="{x:Bind}" Text="Export again…" />
                                    <MenuFlyoutItem Click="CopyLink_Click" Tag="{x:Bind}" Text="Copy link" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="Remove_Click" Tag="{x:Bind}" Text="Remove from activity" Visibility="{x:Bind IsFinished, Mode=OneWay}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <media:RowMediaView Media="{x:Bind Media}">
                                <media:RowMediaView.Details>
                                    <StackPanel Margin="0,6,0,0" Spacing="5">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressRing
                                                Width="14"
                                                Height="14"
                                                MinWidth="0"
                                                MinHeight="0"
                                                IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                                Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                            <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE823;" Style="{StaticResource StateIconStyle}" Visibility="{x:Bind IsQueued, Mode=OneWay}" />
                                            <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xEC61;" Style="{StaticResource StateIconStyle}" Visibility="{x:Bind IsCompleted, Mode=OneWay}" />
                                            <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEA39;" Style="{StaticResource StateIconStyle}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                            <FontIcon Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE711;" Style="{StaticResource StateIconStyle}" Visibility="{x:Bind IsCancelled, Mode=OneWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                MaxLines="2"
                                                Text="{x:Bind Status, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ProgressDetail, Mode=OneWay}" />
                                        </StackPanel>
                                        <ProgressBar
                                            Height="3"
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}"
                                            Value="{x:Bind Progress, Mode=OneWay}" />
                                    </StackPanel>
                                </media:RowMediaView.Details>
                            </media:RowMediaView>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    AutomationProperties.Name="Show in folder"
                                    Command="{x:Bind ShowInFolderCommand}"
                                    Style="{StaticResource ActivityIconButtonStyle}"
                                    ToolTipService.ToolTip="Show in folder"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    Click="Retry_Click"
                                    Content="Retry"
                                    Tag="{x:Bind}"
                                    Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                </Button>
                                <Button
                                    Command="{x:Bind CancelCommand}"
                                    Content="Cancel"
                                    Visibility="{x:Bind IsActive, Mode=OneWay}">
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </controls:EdgeFade>
    </Grid>
</Page>
