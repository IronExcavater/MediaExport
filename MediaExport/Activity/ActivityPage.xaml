<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Activity"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <StackPanel
            MaxWidth="420"
            Margin="24,0,24,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind converters:Show.Unless(ViewModel.HasJobs), Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,8"
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Nothing exported yet" />
        </StackPanel>

        <Grid
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="24,12,24,0"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.HasJobs, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="removeButton"
                    Click="Remove_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Remove the selected exports from this list. Their files stay where they are.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Remove" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind jobList}" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearFinishedCommand}" ToolTipService.ToolTip="Remove every finished export from this list. Their files stay where they are.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                        <TextBlock Text="Clear finished" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView
                x:Name="jobList"
                Grid.Row="1"
                Padding="0,0,0,24"
                DoubleTapped="JobList_DoubleTapped"
                ItemsSource="{x:Bind ViewModel.Jobs}"
                SelectionChanged="JobList_SelectionChanged"
                SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ExportJob">
                        <Grid ColumnSpacing="16">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Command="{x:Bind OpenCommand}" Text="Open">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ShowInFolderCommand}" Text="Show in folder">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="ExportAgain_Click" Tag="{x:Bind}" Text="Export again">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="CopyLink_Click" Tag="{x:Bind}" Text="Copy link">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="RemoveOne_Click" Tag="{x:Bind}" Text="Remove from list">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="80"
                                Height="45"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{x:Bind Media.ThumbnailUri}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Media.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" MaxWidth="320" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.Name="Cancel"
                                    Command="{x:Bind CancelCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Cancel"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE711;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Open"
                                    Command="{x:Bind OpenCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Open"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Show in folder"
                                    Command="{x:Bind ShowInFolderCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="Show in folder"
                                    Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                            </StackPanel>

                            <!-- Along the row's bottom edge, so progress doesn't make the row taller. -->
                            <ProgressBar
                                Grid.ColumnSpan="3"
                                Margin="-8,0,-8,-8"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                Visibility="{x:Bind ShowsProgress, Mode=OneWay}"
                                Value="{x:Bind DisplayProgress, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
