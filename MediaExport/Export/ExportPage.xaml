<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:MediaExport.Media.Controls"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="{StaticResource PagePadding}"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Export" />

        <!-- The media that is open. It is a skeleton of itself while its link is being read. -->
        <media:CardMediaView
            Grid.Row="1"
            MaxWidth="720"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Media="{x:Bind ViewModel.Media, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}" />
    </Grid>
</Page>
