<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:shell="using:MediaExport.Shell"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="ExportIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="OptionLabelStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="24,16,24,24">
        <controls:EmptyStateView
            Title="Choose media to export"
            Glyph="&#xE896;"
            Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsOpen), Mode=OneWay}">
            <controls:EmptyStateView.Action>
                <Button Click="Search_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource FieldIconStyle}" />
                        <TextBlock Text="Search for media" />
                    </StackPanel>
                </Button>
            </controls:EmptyStateView.Action>
        </controls:EmptyStateView>

        <Grid
            x:Name="editor"
            ColumnSpacing="24"
            SizeChanged="Editor_SizeChanged"
            Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="panelColumn" Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="mediaRow" Height="*" />
                <RowDefinition x:Name="panelRow" Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="mediaArea" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <media:PlayerMediaView
                    x:Name="player"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    Media="{x:Bind ViewModel.Media, Mode=OneWay}" />

                <Grid
                    x:Name="words"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    ColumnSpacing="12"
                    SizeChanged="Editor_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Media.Title, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <media:MediaByline Media="{x:Bind ViewModel.Media, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Remove media"
                        Click="Close_Click"
                        Style="{StaticResource ExportIconButtonStyle}"
                        ToolTipService.ToolTip="Remove media from this page">
                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Grid>

            <Grid
                x:Name="panel"
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="20" Spacing="16">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Export" />

                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind converters:Is.NotBlank(ViewModel.AvailabilityMessage), Mode=OneWay}"
                            Message="{x:Bind ViewModel.AvailabilityMessage, Mode=OneWay}"
                            Severity="Warning"
                            Title="Can’t export this media" />

                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanEditExport, Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Type" />
                                        <ComboBox
                                            x:Name="ExportModeComboBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.ExportModes, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedExportMode, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Format" />
                                        <ComboBox
                                            x:Name="ExportFormatComboBox"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6" Visibility="{x:Bind converters:VisibleWhen.True(ViewModel.IsAudioExport), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Audio quality" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.AudioBitrates, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedAudioBitrate, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Spacing="6" Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsAudioExport), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Maximum resolution" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.VideoResolutions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedVideoResolution, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Folder" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            MinHeight="40"
                                            Padding="12,8"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind ViewModel.SelectedOutputFolder, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Choose export folder"
                                            Click="BrowseOutputFolder_Click"
                                            Style="{StaticResource ExportIconButtonStyle}"
                                            ToolTipService.ToolTip="Choose export folder">
                                            <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Grid.Row="1"
                    Padding="16,12,16,14"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                    <Button
                        MinHeight="48"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Export"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18">
                                <FontIcon
                                    FontSize="16"
                                    Glyph="&#xE896;"
                                    Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsExportBusy), Mode=OneWay}" />
                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    MinWidth="0"
                                    MinHeight="0"
                                    IsActive="{x:Bind ViewModel.IsExportBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsExportBusy, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.ExportActionText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind ViewModel.ExportProgressDetail, Mode=OneWay}" />
                            <ProgressBar
                                Grid.ColumnSpan="3"
                                Height="3"
                                Margin="0,30,0,0"
                                VerticalAlignment="Top"
                                IsIndeterminate="{x:Bind ViewModel.IsExportProgressIndeterminate, Mode=OneWay}"
                                Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{x:Bind shell:WindowSizes.Wide}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="panelColumn.Width" Value="0" />
                        <Setter Target="mediaRow.Height" Value="Auto" />
                        <Setter Target="panelRow.Height" Value="*" />
                        <Setter Target="editor.ColumnSpacing" Value="0" />
                        <Setter Target="editor.RowSpacing" Value="16" />
                        <Setter Target="panel.(Grid.Row)" Value="1" />
                        <Setter Target="panel.(Grid.Column)" Value="0" />
                        <Setter Target="player.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="player.Height" Value="120" />
                        <Setter Target="player.MaxWidth" Value="260" />
                        <Setter Target="words.(Grid.Row)" Value="0" />
                        <Setter Target="words.(Grid.Column)" Value="1" />
                        <Setter Target="words.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
