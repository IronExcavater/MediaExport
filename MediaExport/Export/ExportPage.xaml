<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activity="using:MediaExport.Activity"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Export"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A choice's name, and beside it what it means (a size, or what a format is good for). -->
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="local:Choice">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Detail}" />
            </Grid>
        </DataTemplate>

        <!-- A setting in the export list: its name on the left, its control on the right. -->
        <Style x:Key="OptionRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="OptionHeaderStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="OptionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OptionSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>

        <converters:PassThroughConverter x:Key="PassThrough" />
    </Page.Resources>

    <Grid>
        <!-- Home: what was picked and exported lately, so it's one click to carry on. -->
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind converters:Show.Unless(ViewModel.HasMedia), Mode=OneWay}">
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="24"
                Spacing="32">

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind converters:Show.WhenText(ClipboardLink), Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE71B;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Export the link you copied?" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ClipboardLink, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="OpenClipboardLink_Click"
                            Content="Open"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind Search.HasRecents, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Jump back in" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="Recent_ItemClick"
                        ItemsSource="{x:Bind Search.Recents}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaSearchResult">
                                <StackPanel Width="232" Spacing="8">
                                    <Grid
                                        Height="130"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind ThumbnailUri}" />
                                            </Image.Source>
                                        </Image>
                                        <Border
                                            Margin="6"
                                            Padding="5,2,5,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            CornerRadius="4"
                                            Opacity="0.9"
                                            Visibility="{x:Bind converters:Show.WhenSet(Duration)}">
                                            <TextBlock FontSize="12" Text="{x:Bind converters:Format.Duration(Duration)}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <!-- Where it's from, then who made it. -->
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconView
                                                Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind ProviderId}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="{x:Bind Creator}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="Padding" Value="6" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind Activity.HasJobs, Mode=OneWay}">
                    <Grid>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recent exports" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="SeeAllExports_Click"
                            Content="See all" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Activity.Latest}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="activity:ExportJob">
                                <Grid
                                    Margin="0,0,0,4"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="64"
                                        Height="36"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind Media.ThumbnailUri}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Media.Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind Status, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <StackPanel
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            AutomationProperties.Name="Open"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Open"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Show in folder"
                                            Command="{x:Bind ShowInFolderCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Show in folder"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Over the card's bottom edge, so a running export doesn't make the row taller. -->
                                    <ProgressBar
                                        Grid.ColumnSpan="4"
                                        Margin="-8,0,-8,-8"
                                        VerticalAlignment="Bottom"
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                        ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                        Value="{x:Bind DisplayProgress, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- First run: nothing picked or exported yet. -->
                <StackPanel
                    MaxWidth="420"
                    Margin="0,64,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind converters:Show.WhenNone(Search.HasRecents, Activity.HasJobs), Mode=OneWay}">
                    <Image
                        Width="72"
                        Height="72"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Save video and audio to keep" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Search, or paste a link from almost any video or music site."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="StartSearching_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE721;" />
                            <TextBlock Text="Start searching" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor: the player and clips on the left, how to save it on the right. -->
        <ScrollViewer
            x:Name="editorScroller"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="Layout_SizeChanged"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.HasMedia, Mode=OneWay}">
            <Grid
                x:Name="editor"
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="24,16,24,24"
                ColumnSpacing="24"
                RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="panelColumn" Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="panelRow" Height="0" />
                </Grid.RowDefinitions>

                <!--
                    The player takes the height the details and clips don't need. The clips stay at the bottom
                    of the page, so they're in the same place whatever's playing; a short player leaves the gap above them.
                -->
                <Grid
                    x:Name="stage"
                    VerticalAlignment="Top"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <media:PlayerView
                        x:Name="player"
                        IsPlayerHidden="{x:Bind Search.IsPlayerObscured, Mode=OneWay}"
                        Media="{x:Bind ViewModel.Media, Mode=OneWay}" />

                    <!-- What it is and who made it; the timeline below already says how long it is. -->
                    <Grid
                        x:Name="details"
                        Grid.Row="1"
                        ColumnSpacing="12"
                        SizeChanged="Layout_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Media.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Media.Title, Mode=OneWay}" />
                            <!-- Where it's from, who made it, how long it is. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <controls:IconView
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind ViewModel.Media.ProviderId, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ProviderName, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="·"
                                    Visibility="{x:Bind converters:Show.WhenText(ViewModel.Media.Creator), Mode=OneWay}" />
                                <HyperlinkButton
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="Creator_Click"
                                    Content="{x:Bind ViewModel.Media.Creator, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.HasCreatorLink, Mode=OneWay}"
                                    ToolTipService.ToolTip="Open their page"
                                    Visibility="{x:Bind converters:Show.WhenText(ViewModel.Media.Creator), Mode=OneWay}" />
                                <Border
                                    Padding="6,1,6,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind converters:Show.WhenSet(ViewModel.Media.Duration), Mode=OneWay}">
                                    <TextBlock FontSize="12" Text="{x:Bind converters:Format.Duration(ViewModel.Media.Duration), Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="Open in browser"
                                Click="OpenInBrowser_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Open in browser">
                                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Copy link"
                                Click="CopyLink_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Copy link">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Close"
                                Click="Close_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Close">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Clips: which parts to keep. -->
                    <Border
                        x:Name="clipsCard"
                        Grid.Row="3"
                        Padding="16,12,16,14"
                        SizeChanged="Layout_SizeChanged"
                        Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Clips" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ClipsSummary, Mode=OneWay}" />

                                <!-- Where the player is, with a step either way; only for players that say where they are. -->
                                <StackPanel
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{x:Bind FollowsPlayhead, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.Name="Back 10 seconds"
                                        Click="SkipBack_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Back 10 seconds">
                                        <FontIcon FontSize="16" Glyph="&#xED3C;" />
                                    </Button>
                                    <StackPanel
                                        MinWidth="104"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind converters:Format.Time(player.Position), Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="/" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind converters:Format.Time(ViewModel.Duration), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        AutomationProperties.Name="Forward 30 seconds"
                                        Click="SkipForward_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Forward 30 seconds">
                                        <FontIcon FontSize="16" Glyph="&#xED3D;" />
                                    </Button>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button AutomationProperties.Name="Add clip" Click="AddClip_Click" ToolTipService.ToolTip="Add a clip where the player is">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                            <TextBlock Text="Add clip" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Clip each chapter"
                                        Command="{x:Bind ViewModel.ClipChaptersCommand}"
                                        ToolTipService.ToolTip="A clip for every chapter, each saved as its own file"
                                        Visibility="{x:Bind ViewModel.HasChapters, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="14" Glyph="&#xE8A4;" />
                                            <TextBlock Text="Clip each chapter" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Keep all of it"
                                        Command="{x:Bind ViewModel.ClearClipsCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Remove every clip and keep all of it"
                                        Visibility="{x:Bind ViewModel.HasClips, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <media:ClipTimeline
                                x:Name="timeline"
                                Chapters="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                                Clips="{x:Bind ViewModel.Clips}"
                                Duration="{x:Bind ViewModel.Duration, Mode=OneWay}"
                                Position="{x:Bind player.Position, Mode=OneWay}"
                                SeekRequested="Timeline_SeekRequested"
                                SelectedIndex="{x:Bind ViewModel.SelectedClip, Mode=TwoWay}" />

                            <!-- Every clip, numbered as on the timeline; picking one selects it and plays from its start. -->
                            <ItemsControl
                                ItemsPanel="{StaticResource WrapPanelTemplate}"
                                ItemsSource="{x:Bind ViewModel.ClipItems}"
                                Visibility="{x:Bind ViewModel.HasClips, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ClipItem">
                                        <ToggleButton
                                            Padding="6,4,12,5"
                                            AutomationProperties.Name="{x:Bind}"
                                            Click="ClipItem_Click"
                                            CornerRadius="16"
                                            IsChecked="{x:Bind IsSelected}"
                                            Tag="{x:Bind Index}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                    MinWidth="22"
                                                    Height="22"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="11">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{x:Bind Number}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Range}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The selected clip's exact times, and what to make of several clips. -->
                            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasClips, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind HasSelectedClip, Mode=OneWay}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="From" />
                                    <TextBox
                                        x:Name="clipStart"
                                        Width="88"
                                        AutomationProperties.Name="Clip start"
                                        KeyDown="ClipTime_KeyDown"
                                        LostFocus="ClipTime_LostFocus" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="to" />
                                    <TextBox
                                        x:Name="clipEnd"
                                        Width="88"
                                        AutomationProperties.Name="Clip end"
                                        KeyDown="ClipTime_KeyDown"
                                        LostFocus="ClipTime_LostFocus" />
                                    <!-- Said in words: the two arrows these used to be were easy to mix up. -->
                                    <Button
                                        Margin="4,0,0,0"
                                        Click="MarkStart_Click"
                                        Content="Start here"
                                        ToolTipService.ToolTip="Start the clip where the player is"
                                        Visibility="{x:Bind FollowsPlayhead, Mode=OneWay}" />
                                    <Button
                                        Click="MarkEnd_Click"
                                        Content="End here"
                                        ToolTipService.ToolTip="End the clip where the player is"
                                        Visibility="{x:Bind FollowsPlayhead, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.Name="Remove clip"
                                        Click="RemoveClip_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Remove clip (Delete)">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasSeveralClips, Mode=OneWay}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Save as" />
                                    <ComboBox
                                        MinWidth="130"
                                        AutomationProperties.Name="Save the clips as"
                                        SelectedIndex="{x:Bind local:ExportPage.JoinIndex(ViewModel.JoinClips), Mode=TwoWay, BindBack=SetJoinIndex}">
                                        <x:String>One file</x:String>
                                        <x:String>A file each</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- How to save it: one compact list, read top to bottom, ending in the button. -->
                <Grid
                    x:Name="panel"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,8,16,16">
                            <Grid Style="{StaticResource OptionHeaderStyle}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Video" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Include video"
                                    IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.IncludeVideo, Mode=TwoWay}"
                                    Style="{StaticResource OptionSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRowStyle}" IsHitTestVisible="{x:Bind ViewModel.IncludeVideo, Mode=OneWay}" Opacity="{x:Bind local:ExportPage.Dim(ViewModel.IncludeVideo), Mode=OneWay}">
                                <TextBlock Text="Quality" VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="Video quality"
                                    ItemTemplate="{StaticResource ChoiceTemplate}"
                                    ItemsSource="{x:Bind ViewModel.VideoQuality.Items}"
                                    SelectedItem="{x:Bind ViewModel.VideoQuality.Selected, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                                    Style="{StaticResource OptionComboBoxStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRowStyle}" IsHitTestVisible="{x:Bind ViewModel.IncludeVideo, Mode=OneWay}" Opacity="{x:Bind local:ExportPage.Dim(ViewModel.IncludeVideo), Mode=OneWay}">
                                <TextBlock Text="Format" VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="Video format"
                                    ItemTemplate="{StaticResource ChoiceTemplate}"
                                    ItemsSource="{x:Bind ViewModel.VideoFormat.Items}"
                                    SelectedItem="{x:Bind ViewModel.VideoFormat.Selected, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                                    Style="{StaticResource OptionComboBoxStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRowStyle}" Visibility="{x:Bind ViewModel.CanChooseSubtitles, Mode=OneWay}">
                                <TextBlock Text="Subtitles" VerticalAlignment="Center" />
                                <DropDownButton
                                    MinWidth="170"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Subtitles"
                                    Content="{x:Bind ViewModel.SubtitlesSummary, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Opening="Subtitles_Opening" Placement="BottomEdgeAlignedRight" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <Grid Margin="0,8,0,0" Style="{StaticResource OptionHeaderStyle}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Audio" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Include audio"
                                    IsOn="{x:Bind ViewModel.IncludeAudio, Mode=TwoWay}"
                                    Style="{StaticResource OptionSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRowStyle}" IsHitTestVisible="{x:Bind ViewModel.IncludeAudio, Mode=OneWay}" Opacity="{x:Bind local:ExportPage.Dim(ViewModel.IncludeAudio), Mode=OneWay}">
                                <TextBlock Text="Quality" VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="Audio quality"
                                    ItemTemplate="{StaticResource ChoiceTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AudioQuality.Items}"
                                    SelectedItem="{x:Bind ViewModel.AudioQuality.Selected, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                                    Style="{StaticResource OptionComboBoxStyle}" />
                            </Grid>
                            <!-- With video, the sound is stored the way the video's format expects, so there's nothing to pick. -->
                            <Grid Style="{StaticResource OptionRowStyle}" IsHitTestVisible="{x:Bind ViewModel.IncludeAudio, Mode=OneWay}" Opacity="{x:Bind local:ExportPage.Dim(ViewModel.IncludeAudio), Mode=OneWay}">
                                <TextBlock Text="Format" VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="Audio format"
                                    ItemTemplate="{StaticResource ChoiceTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AudioFormat.Items}"
                                    SelectedItem="{x:Bind ViewModel.AudioFormat.Selected, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                                    Style="{StaticResource OptionComboBoxStyle}"
                                    Visibility="{x:Bind ViewModel.IsAudioOnly, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.AudioCodec, Mode=OneWay}"
                                    Visibility="{x:Bind converters:Show.Unless(ViewModel.IsAudioOnly), Mode=OneWay}" />
                            </Grid>

                            <TextBlock Margin="0,16,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Also include" />
                            <Grid Style="{StaticResource OptionRowStyle}">
                                <TextBlock Text="Title, creator and cover art" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Title, creator and cover art"
                                    IsOn="{x:Bind ViewModel.EmbedDetails, Mode=TwoWay}"
                                    Style="{StaticResource OptionSwitchStyle}" />
                            </Grid>
                            <Grid Style="{StaticResource OptionRowStyle}" Visibility="{x:Bind ViewModel.CanEmbedChapters, Mode=OneWay}">
                                <TextBlock Text="Chapter markers" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Chapter markers"
                                    IsOn="{x:Bind ViewModel.EmbedChapters, Mode=TwoWay}"
                                    Style="{StaticResource OptionSwitchStyle}" />
                            </Grid>
                            <Grid
                                Style="{StaticResource OptionRowStyle}"
                                ToolTipService.ToolTip="Sponsors, self-promotion and subscribe reminders, as marked by SponsorBlock"
                                Visibility="{x:Bind ViewModel.CanRemoveSponsors, Mode=OneWay}">
                                <TextBlock Text="Cut sponsor segments" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Cut sponsor segments"
                                    IsOn="{x:Bind ViewModel.RemoveSponsors, Mode=TwoWay}"
                                    Style="{StaticResource OptionSwitchStyle}" />
                            </Grid>

                            <TextBlock Margin="0,16,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save to" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="Change folder"
                                    Click="ChangeFolder_Click"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolder, Mode=OneWay}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Open folder"
                                    Command="{x:Bind ViewModel.OpenFolderCommand}"
                                    ToolTipService.ToolTip="Open folder">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,4,0,0" Style="{StaticResource OptionRowStyle}">
                                <TextBlock Text="File name" VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="File name"
                                    ItemTemplate="{StaticResource ChoiceTemplate}"
                                    ItemsSource="{x:Bind ViewModel.FileName.Items}"
                                    SelectedItem="{x:Bind ViewModel.FileName.Selected, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                                    Style="{StaticResource OptionComboBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- What's about to be made, the one button that makes it, and a line on where things stand. -->
                    <StackPanel
                        Grid.Row="1"
                        Padding="16,14,16,12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,7,7"
                        Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6">
                                <FontIcon FontSize="18" Glyph="{x:Bind ViewModel.ExportKindGlyph, Mode=OneWay}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.FileNamePreview, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.FileNamePreview, Mode=OneWay}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.ExportSummary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ExportSummary, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid Height="44">
                            <Button
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ExportLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ExportCommand}"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Ctrl+E"
                                Visibility="{x:Bind converters:Show.WhenNone(ViewModel.IsRunning, ViewModel.IsDone), Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="E" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.ExportGlyph, Mode=OneWay}" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind ViewModel.ExportLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <!-- Running: the button fills up as it goes; the cross cancels. -->
                            <Grid
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.35"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" />
                                    </Border.RenderTransform>
                                </Border>
                                <Grid Padding="12,0,4,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.JobStatus, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Cancel export"
                                        Command="{x:Bind ViewModel.CancelCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Cancel">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <SplitButton
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.HelpText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Job.ShowInFolderCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight">
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.Job.OpenCommand, Mode=OneWay}" Text="Open">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.ExportAgainCommand}" Text="Export again">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <!-- A failed export's bar stays, in the error colour, along the button's bottom edge. -->
                            <ProgressBar
                                Margin="4,0,4,1"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                ShowError="True"
                                Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}"
                                Value="100" />
                        </Grid>

                        <!-- Two lines are always kept for this, so nothing moves when it changes. -->
                        <Grid Height="36" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" VerticalAlignment="Top">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B7;"
                                    Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    Margin="0,2,0,0"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;"
                                    Visibility="{x:Bind ViewModel.IsBlocked, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEA39;"
                                    Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xEC61;"
                                    Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                MaxLines="2"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1080" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow windows stack everything and scroll. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="panelColumn.Width" Value="0" />
                        <Setter Target="panelRow.Height" Value="Auto" />
                        <Setter Target="editor.ColumnSpacing" Value="0" />
                        <Setter Target="panel.(Grid.Row)" Value="1" />
                        <Setter Target="panel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
