<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activity="using:MediaExport.Activity"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Export"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="ChipTemplate" x:DataType="local:Choice">
            <RadioButton
                Content="{x:Bind Label}"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                Style="{StaticResource ChipRadioButtonStyle}"
                ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" />
        </DataTemplate>

        <Style x:Key="OptionLabelStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A switch with a sentence saying what it does. -->
        <Style x:Key="OptionSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,-12,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Home: what was picked and exported lately, so it's one click to carry on. -->
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind converters:Show.Unless(ViewModel.HasMedia), Mode=OneWay}">
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Padding="24"
                Spacing="32">

                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind converters:Show.WhenText(ClipboardLink), Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="20" Glyph="&#xE71B;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Export the link you copied?" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ClipboardLink, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="OpenClipboardLink_Click"
                            Content="Open"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Spacing="12" Visibility="{x:Bind HasRecents, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Jump back in" />
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="Recent_ItemClick"
                        ItemsSource="{x:Bind Search.Recents}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaSearchResult">
                                <StackPanel Width="232" Spacing="8">
                                    <Grid
                                        Height="130"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind ThumbnailUri}" />
                                            </Image.Source>
                                        </Image>
                                        <Border
                                            Margin="6"
                                            Padding="4,1,4,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            CornerRadius="4"
                                            Opacity="0.9">
                                            <Image Width="18" Height="18" Source="{x:Bind ProviderId, Converter={StaticResource IconImageConverter}}" />
                                        </Border>
                                        <Border
                                            Margin="6"
                                            Padding="5,2,5,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            CornerRadius="4"
                                            Opacity="0.9"
                                            Visibility="{x:Bind local:ExportPage.ShowDuration(Duration)}">
                                            <TextBlock FontSize="12" Text="{x:Bind local:ExportPage.FormatDuration(Duration)}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Creator}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                        <GridView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="Padding" Value="6" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind Activity.HasJobs, Mode=OneWay}">
                    <Grid>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recent exports" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="SeeAllExports_Click"
                            Content="See all" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Activity.Latest}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="activity:ExportJob">
                                <Grid
                                    Margin="0,0,0,4"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    ColumnSpacing="16"
                                    CornerRadius="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="64"
                                        Height="36"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind Media.ThumbnailUri}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Media.Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap">
                                            <Run Text="{x:Bind Summary}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Status, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            AutomationProperties.Name="Open"
                                            Command="{x:Bind OpenCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Open"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Show in folder"
                                            Command="{x:Bind ShowInFolderCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Show in folder"
                                            Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                                        </Button>
                                    </StackPanel>
                                    <!-- Over the card's bottom edge, so a running export doesn't make the row taller. -->
                                    <ProgressBar
                                        Grid.ColumnSpan="3"
                                        Margin="-8,0,-8,-8"
                                        VerticalAlignment="Bottom"
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                        ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                        Value="{x:Bind DisplayProgress, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- First run: nothing picked or exported yet. -->
                <StackPanel
                    MaxWidth="420"
                    Margin="0,64,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind converters:Show.WhenNone(HasRecents, Activity.HasJobs), Mode=OneWay}">
                    <Image
                        Width="72"
                        Height="72"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Save video and audio to keep" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Search YouTube or SoundCloud, or paste a link from almost any video or music site."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="StartSearching_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE721;" />
                            <TextBlock Text="Start searching" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor: the player and timeline on the left, how to save it on the right. -->
        <ScrollViewer
            x:Name="editorScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Disabled"
            Visibility="{x:Bind ViewModel.HasMedia, Mode=OneWay}">
            <Grid
                x:Name="editor"
                MaxWidth="{StaticResource PageMaxWidth}"
                SizeChanged="Stage_SizeChanged"
                Padding="24,16,24,24"
                ColumnSpacing="24"
                RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="panelColumn" Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="panelRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- The player takes the height the details and clips don't need, so they sit right under it. -->
                <Grid
                    x:Name="stage"
                    VerticalAlignment="Top"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <media:PlayerView
                        x:Name="player"
                        IsPlayerHidden="{x:Bind IsPlayerObscured, Mode=OneWay}"
                        Media="{x:Bind ViewModel.Media, Mode=OneWay}" />

                    <!-- What it is, in one line, like the search results. -->
                    <Grid
                        x:Name="details"
                        Grid.Row="1"
                        ColumnSpacing="12"
                        SizeChanged="Stage_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.Media.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Media.Title, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Source="{x:Bind ViewModel.Media.ProviderId, Mode=OneWay, Converter={StaticResource IconImageConverter}}" />
                                <HyperlinkButton
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="Creator_Click"
                                    IsEnabled="{x:Bind HasCreatorLink, Mode=OneWay}"
                                    ToolTipService.ToolTip="Open their page">
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Media.Creator, Mode=OneWay}" />
                                </HyperlinkButton>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind local:ExportPage.FormatDuration(ViewModel.Media.Duration), Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="Open in browser"
                                Click="OpenInBrowser_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Open in browser">
                                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Copy link"
                                Click="CopyLink_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Copy link">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Close"
                                Click="Close_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Close">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Clips: which parts to keep. -->
                    <Grid
                        x:Name="clipsCard"
                        Grid.Row="2"
                        Padding="16,12,16,8"
                        SizeChanged="Stage_SizeChanged"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Keep" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.ClipsSummary, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button AutomationProperties.Name="Start here" Click="MarkStart_Click" ToolTipService.ToolTip="Start a clip where the player is">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="14" Glyph="&#xE892;" />
                                        <TextBlock Text="Start here" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="End here" Click="MarkEnd_Click" ToolTipService.ToolTip="End the clip where the player is">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="End here" />
                                        <FontIcon FontSize="14" Glyph="&#xE893;" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <media:ClipTimeline
                            x:Name="timeline"
                            Grid.Row="1"
                            Chapters="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                            Clips="{x:Bind ViewModel.Clips}"
                            Duration="{x:Bind ViewModel.Duration, Mode=OneWay}"
                            Position="{x:Bind player.Position, Mode=OneWay}"
                            SeekRequested="Timeline_SeekRequested"
                            SelectedIndex="{x:Bind SelectedClip, Mode=TwoWay}" />

                        <!-- Either how to use the timeline, or the selected clip's exact times: same space, so nothing moves. -->
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="Drag across the timeline to keep only part of it. Click a chapter to keep that chapter."
                            Visibility="{x:Bind converters:Show.Unless(HasSelectedClip), Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind HasSelectedClip, Mode=OneWay}">
                            <TextBlock VerticalAlignment="Center" Text="From" />
                            <TextBox
                                x:Name="clipStart"
                                Width="96"
                                AutomationProperties.Name="Clip start"
                                KeyDown="ClipTime_KeyDown"
                                LostFocus="ClipTime_LostFocus" />
                            <TextBlock VerticalAlignment="Center" Text="to" />
                            <TextBox
                                x:Name="clipEnd"
                                Width="96"
                                AutomationProperties.Name="Clip end"
                                KeyDown="ClipTime_KeyDown"
                                LostFocus="ClipTime_LostFocus" />
                            <Button
                                AutomationProperties.Name="Remove clip"
                                Click="RemoveClip_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Remove clip (Delete)">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                            <HyperlinkButton
                                Command="{x:Bind ViewModel.ClearClipsCommand}"
                                Content="Keep all of it"
                                Visibility="{x:Bind ViewModel.HasClips, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- How to save it: one surface, read top to bottom, ending in the button. -->
                <Grid
                    x:Name="panel"
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16" Spacing="20">
                            <StackPanel>
                                <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Save as" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        GroupName="kind" AutomationProperties.Name="Video"
                                        IsChecked="{x:Bind ViewModel.Kind.Items[0].IsSelected, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.Kind.Items[0].IsEnabled, Mode=OneWay}"
                                        Style="{StaticResource TileRadioButtonStyle}">
                                        <StackPanel Spacing="4">
                                            <FontIcon
                                                HorizontalAlignment="Left"
                                                FontSize="20"
                                                Glyph="&#xE714;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Video" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="{x:Bind ViewModel.Kind.Items[0].Detail, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton
                                        Grid.Column="1"
                                        GroupName="kind" AutomationProperties.Name="Audio only"
                                        IsChecked="{x:Bind ViewModel.Kind.Items[1].IsSelected, Mode=TwoWay}"
                                        Style="{StaticResource TileRadioButtonStyle}">
                                        <StackPanel Spacing="4">
                                            <FontIcon
                                                HorizontalAlignment="Left"
                                                FontSize="20"
                                                Glyph="&#xE8D6;" />
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Audio only" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="{x:Bind ViewModel.Kind.Items[1].Detail, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                                <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Quality" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource ChipTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{x:Bind ViewModel.VideoQuality.Items}" />
                            </StackPanel>
                            <StackPanel Visibility="{x:Bind ViewModel.IsAudio, Mode=OneWay}">
                                <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Quality" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource ChipTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AudioQuality.Items}" />
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind ViewModel.IsVideo, Mode=OneWay}">
                                <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Format" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource ChipTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{x:Bind ViewModel.VideoFormat.Items}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.VideoFormat.Selected.Description, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Visibility="{x:Bind ViewModel.IsAudio, Mode=OneWay}">
                                <TextBlock Style="{StaticResource OptionLabelStyle}" Text="Format" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource ChipTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{x:Bind ViewModel.AudioFormat.Items}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.AudioFormat.Selected.Description, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Include" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Details and cover art" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Title, creator and artwork, shown by players" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="Details and cover art"
                                        IsOn="{x:Bind ViewModel.EmbedDetails, Mode=TwoWay}"
                                        Style="{StaticResource OptionSwitchStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="12" Visibility="{x:Bind converters:Show.WhenAll(ViewModel.HasChapters, ViewModel.IsVideo), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Chapters" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Lets players skip between chapters" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="Chapters"
                                        IsEnabled="{x:Bind converters:Show.Not(ViewModel.HasClips), Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.EmbedChapters, Mode=TwoWay}"
                                        Style="{StaticResource OptionSwitchStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasChapters, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="A file per chapter" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind local:ExportPage.ChapterCount(ViewModel.Chapters), Mode=OneWay}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="A file per chapter"
                                        IsEnabled="{x:Bind converters:Show.Not(ViewModel.HasClips), Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.SplitChapters, Mode=TwoWay}"
                                        Style="{StaticResource OptionSwitchStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSeveralClips, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Join the clips" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="One file with every clip, one after another" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="Join the clips"
                                        IsOn="{x:Bind ViewModel.JoinClips, Mode=TwoWay}"
                                        Style="{StaticResource OptionSwitchStyle}" />
                                </Grid>

                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.CanRemoveSponsors, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Cut sponsor segments" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Sponsors, self-promotion and subscribe reminders, as marked by SponsorBlock" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        AutomationProperties.Name="Cut sponsor segments"
                                        IsOn="{x:Bind ViewModel.RemoveSponsors, Mode=TwoWay}"
                                        Style="{StaticResource OptionSwitchStyle}" />
                                </Grid>

                                <StackPanel Spacing="8" Visibility="{x:Bind converters:Show.WhenAll(ViewModel.HasSubtitles, ViewModel.IsVideo), Mode=OneWay}">
                                    <StackPanel>
                                        <TextBlock Text="Subtitles" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Pick any; players let you switch between them" />
                                    </StackPanel>
                                    <ItemsControl ItemsPanel="{StaticResource WrapPanelTemplate}" ItemsSource="{x:Bind ViewModel.Subtitles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:SubtitleChoice">
                                                <ToggleButton
                                                    Content="{x:Bind Track.Name}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource ChipToggleButtonStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save to" />
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="Change folder"
                                        Click="ChangeFolder_Click"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.OutputFolder, Mode=OneWay}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Open folder"
                                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                                        ToolTipService.ToolTip="Open folder">
                                        <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                                    </Button>
                                </Grid>
                                <ItemsControl
                                    Margin="0,4,0,0"
                                    ItemTemplate="{StaticResource ChipTemplate}"
                                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                                    ItemsSource="{x:Bind ViewModel.FileName.Items}" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.FileNamePreview, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.FileNamePreview, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The one button: export, then its progress, then the file. The line below says why it's as it is. -->
                    <StackPanel
                        Grid.Row="1"
                        Padding="16"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Spacing="8">
                        <Grid Height="40">
                            <Button
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.ExportLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ExportCommand}"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind converters:Show.WhenNone(ViewModel.IsRunning, ViewModel.IsDone), Mode=OneWay}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="E" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.ExportGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.ExportLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Grid
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                                <Border
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.3"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}" />
                                    </Border.RenderTransform>
                                </Border>
                                <Grid Padding="12,0,4,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.JobStatus, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Cancel export"
                                        Command="{x:Bind ViewModel.CancelCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Cancel">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <SplitButton
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.HelpText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Job.ShowInFolderCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight">
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.Job.OpenCommand, Mode=OneWay}" Text="Open">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.ExportAgainCommand}" Text="Export again">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <!-- A failed export's bar stays, in the error colour, along the button's bottom edge. -->
                            <ProgressBar
                                Margin="4,0,4,1"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False"
                                ShowError="True"
                                Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}"
                                Value="100" />
                        </Grid>

                        <!-- Two lines are always kept for this, so the page doesn't move when it changes. -->
                        <Grid Height="36" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" VerticalAlignment="Top">
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    Margin="0,2,0,0"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;"
                                    Visibility="{x:Bind ViewModel.IsBlocked, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEA39;"
                                    Visibility="{x:Bind ViewModel.IsFailed, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xEC61;"
                                    Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                MaxLines="2"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow windows stack everything and scroll. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="editorScroller.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="panelColumn.Width" Value="0" />
                        <Setter Target="panelRow.Height" Value="Auto" />
                        <Setter Target="editor.ColumnSpacing" Value="0" />
                        <Setter Target="panel.(Grid.Row)" Value="1" />
                        <Setter Target="panel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
