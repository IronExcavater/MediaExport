<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:shell="using:MediaExport.Shell"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="24,16,24,24">
        <controls:EmptyStateView
            Title="Choose media to export"
            Glyph="&#xE896;"
            Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsOpen), Mode=OneWay}">
            <controls:EmptyStateView.Action>
                <Button Click="Search_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource FieldIconStyle}" />
                        <TextBlock Text="Search for media" />
                    </StackPanel>
                </Button>
            </controls:EmptyStateView.Action>
        </controls:EmptyStateView>

        <!--
            The media that is open and how it is to be exported. A wide window has the media as a card on the left
            and the panel beside it. A narrow one has the media as a row along the top and the panel under it.
            Either way the page fits the window, so nothing scrolls.
        -->
        <Grid
            x:Name="editor"
            ColumnSpacing="24"
            SizeChanged="Editor_SizeChanged"
            Visibility="{x:Bind ViewModel.IsOpen, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="panelColumn" Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="mediaRow" Height="*" />
                <RowDefinition x:Name="panelRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                There is one player, which the two layouts place differently, so what is playing carries on when
                the window is resized. It is a skeleton of itself while the media's link is being read.
            -->
            <Grid
                x:Name="mediaArea"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <media:PlayerMediaView
                    x:Name="player"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    Media="{x:Bind ViewModel.Media, Mode=OneWay}" />

                <!-- FallbackValue empties the title while there is no media, or the last one's would stay. -->
                <Grid
                    x:Name="words"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    ColumnSpacing="8"
                    SizeChanged="Editor_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            MaxLines="2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Media.Title, Mode=OneWay, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <media:MediaByline Media="{x:Bind ViewModel.Media, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Remove selected media"
                        Click="Close_Click"
                        Content="Remove media"
                        ToolTipService.ToolTip="Remove from the Export page">
                    </Button>
                </Grid>
            </Grid>

            <Grid
                x:Name="panel"
                Grid.Column="1"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Export settings. The button remains fixed in the row below. -->
                <ScrollViewer
                    Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsLoading), Mode=OneWay}">

                    <StackPanel Padding="20" Spacing="18">
                        <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsInspecting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsInspecting, Mode=OneWay}" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind converters:Is.NotBlank(ViewModel.AvailabilityMessage), Mode=OneWay}"
                            Message="{x:Bind ViewModel.AvailabilityMessage, Mode=OneWay}"
                            Severity="Warning"
                            Title="Can’t export this media" />
                        <ContentControl IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
                            <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Export type" />

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                x:Name="ExportModeComboBox"
                                ItemsSource="{x:Bind ViewModel.ExportModes, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedExportMode, Mode=TwoWay}" />
                        </StackPanel>
                        
                        <!-- Format -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Export settings" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose your format and quality." />

                            <TextBlock
                                Margin="0,8,0,0"
                                FontWeight="SemiBold"
                                Text="Format" />

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                x:Name="ExportFormatComboBox"
                                ItemsSource="{x:Bind ViewModel.AvailableFormats, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Audio options -->
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind converters:VisibleWhen.True(ViewModel.IsAudioExport), Mode=OneWay}">

                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Audio quality" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Higher bitrates generally produce larger files." />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontWeight="SemiBold"
                                Text="Bitrate" />

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.AudioBitrates, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedAudioBitrate, Mode=TwoWay}" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Bitrate applies to MP3 and M4A. WAV and FLAC use their format's audio encoding settings." />
                        </StackPanel>

                        <!-- Video options -->
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind converters:VisibleWhen.False(ViewModel.IsAudioExport), Mode=OneWay}">

                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Video quality" />

                            <TextBlock
                                Margin="0,4,0,0"
                                FontWeight="SemiBold"
                                Text="Maximum resolution" />

                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.VideoResolutions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedVideoResolution, Mode=TwoWay}" />

                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="The downloader selects the best available video at or below this resolution when possible." />
                        </StackPanel>


                        <!-- Save location -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Save location" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="10,9"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedOutputFolder, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </Border>

                                <Button
                                    Grid.Column="1"
                                    Click="BrowseOutputFolder_Click"
                                    VerticalAlignment="Stretch">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" />
                                        <TextBlock Text="Browse" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- The one button that makes the export, always at the bottom. -->
                <Border
                    Grid.Row="1"
                    Padding="16,12,16,14"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11">
                    <Button
                        Height="44"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Export"
                        Command="{x:Bind ViewModel.ExportCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="16" Glyph="&#xE896;" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="Export" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{x:Bind shell:WindowSizes.Wide}" />
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- The media becomes a row, a small player with its title beside it, and the panel fills the rest. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="panelColumn.Width" Value="0" />
                        <Setter Target="mediaRow.Height" Value="Auto" />
                        <Setter Target="panelRow.Height" Value="*" />
                        <Setter Target="editor.ColumnSpacing" Value="0" />
                        <Setter Target="editor.RowSpacing" Value="16" />
                        <Setter Target="panel.(Grid.Row)" Value="1" />
                        <Setter Target="panel.(Grid.Column)" Value="0" />
                        <Setter Target="player.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="player.Height" Value="120" />
                        <Setter Target="player.MaxWidth" Value="260" />
                        <Setter Target="words.(Grid.Row)" Value="0" />
                        <Setter Target="words.(Grid.Column)" Value="1" />
                        <Setter Target="words.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
