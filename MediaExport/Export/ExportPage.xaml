<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Export.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:MediaExport.Export"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=viewModels:ExportViewModel, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <ComboBox
                Header="Provider"
                ItemsSource="{Binding Providers}"
                SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{Binding IconGlyph}" />
                            <TextBlock Text="{Binding DisplayName}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <AutoSuggestBox
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ItemsSource="{Binding Suggestions}"
                IsSuggestionListOpen="{Binding IsSuggestionListOpen, Mode=TwoWay}"
                TextMemberPath="Title"
                PlaceholderText="Search YouTube"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                SuggestionChosen="SearchBox_SuggestionChosen">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <media:CompactMediaView Media="{Binding}" />
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <ProgressRing IsActive="{Binding IsSearching}" Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding HasSelectedResult, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="2">
                <TextBlock Text="Selected" />
                <media:HeroMediaView Media="{Binding SelectedResult}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
