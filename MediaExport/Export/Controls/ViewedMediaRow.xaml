<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Export.Controls.ViewedMediaRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls">

    <!-- The negative margin takes back the padding a pane item has on its right, so the row ends at the item's edge. -->
    <Grid Margin="0,0,-16,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <controls:IconView
            x:Name="icon"
            Width="16"
            Height="16" />
        <TextBlock
            x:Name="title"
            Grid.Column="1"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis" />

        <!--
            A pinned row keeps a pin at its end. The remove button takes its place while the pointer is over the row,
            and takes no room otherwise, so the title has the row's width.
        -->
        <FontIcon
            x:Name="pinMark"
            Grid.Column="2"
            Margin="-4,0,6,0"
            FontSize="12"
            Glyph="&#xE840;" />
        <Button
            x:Name="removeButton"
            Grid.Column="2"
            Margin="-4,0,3,0"
            AutomationProperties.Name="Remove"
            Click="RemoveButton_Click"
            Style="{StaticResource RowIconButtonStyle}"
            ToolTipService.ToolTip="Remove">
            <FontIcon FontSize="10" Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>
