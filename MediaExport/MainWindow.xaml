<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:shell="using:MediaExport.Shell"
    xmlns:shellControls="using:MediaExport.Shell.Controls"
    xmlns:search="using:MediaExport.Search.Controls"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The app shell has the title bar on top, the navigation pane on the left, and the selected page beside it. -->
    <Grid
        x:Name="root"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="Root_Loaded">
        <Grid.Resources>
            <!--
                A badge that counts the exports waiting and running, inside a ring that fills as they get on. It
                reads both from its DataContext, the ActivityViewModel, as a template cannot use x:Bind on the window.
            -->
            <Style x:Key="ProgressBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Height" Value="24" />
                <!-- An InfoBadge is at most 16 high unless told otherwise, which cut the ring off. -->
                <Setter Property="MaxHeight" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="InfoBadge">
                            <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ProgressRing
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                    IsIndeterminate="{Binding IsActiveProgressUnknown}"
                                    Value="{Binding ActiveProgress}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ActiveCount}"
                                    TextLineBounds="Tight" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The badge on a compact pane, where an item is only as wide as its icon and whatever is laid out
                beside the icon is cut off. The negative margin puts the badge where the icon is instead, and
                ShowPaneText hides the icon, so the item shows the count in its place while exports are running.
            -->
            <Style x:Key="CompactProgressBadgeStyle" BasedOn="{StaticResource ProgressBadgeStyle}" TargetType="InfoBadge">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="-39,0,0,0" />
                <Setter Property="Width" Value="16" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
            SizeChanged="TitleBar_SizeChanged">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <!-- The window can still be dragged by the app header, so no extra drag area is needed beside the search. -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>

            <!-- Used instead of TitleBar's Icon and Title, which are fixed at a smaller caption size. -->
            <TitleBar.LeftHeader>
                <!-- MinWidth stops the search field sliding over the logo. -->
                <StackPanel
                    MinWidth="22"
                    Margin="4,0,0,0"
                    Orientation="Horizontal">
                    <!-- Narrowing appName hides the name. The storyboards must be this close to find it. -->
                    <StackPanel.Resources>
                        <CubicEase x:Key="SlideEase" EasingMode="EaseInOut" />
                        <Storyboard x:Name="hideAppName">
                            <DoubleAnimation
                                EasingFunction="{StaticResource SlideEase}"
                                EnableDependentAnimation="True"
                                Storyboard.TargetName="appName"
                                Storyboard.TargetProperty="MaxWidth"
                                To="0"
                                Duration="0:0:0.4" />
                        </Storyboard>
                        <Storyboard x:Name="showAppName">
                            <DoubleAnimation
                                x:Name="showAppNameWidth"
                                EasingFunction="{StaticResource SlideEase}"
                                EnableDependentAnimation="True"
                                Storyboard.TargetName="appName"
                                Storyboard.TargetProperty="MaxWidth"
                                Duration="0:0:0.4" />
                        </Storyboard>
                    </StackPanel.Resources>

                    <!-- Drawn over the app name, which the negative margin starts at the logo's middle. -->
                    <Image
                        Height="22"
                        Margin="0,0,-11,0"
                        VerticalAlignment="Center"
                        Canvas.ZIndex="1"
                        Source="{StaticResource AppLogo}" />

                    <!-- The StackPanel keeps the name full width, so the right-to-left grid cuts off its left. -->
                    <Grid x:Name="appName" FlowDirection="RightToLeft">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="appNameText"
                                Padding="21,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="MediaExport" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TitleBar.LeftHeader>

            <search:SearchInput
                x:Name="searchInput"
                Margin="4,0"
                KeyboardAcceleratorPlacementMode="Hidden"
                LinkSubmitted="SearchInput_LinkSubmitted"
                ResultChosen="SearchInput_ResultChosen"
                Submitted="SearchInput_Submitted"
                ViewModel="{x:Bind Search}">
                <search:SearchInput.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="K"
                        Invoked="FocusSearch_Invoked"
                        Modifiers="Control" />
                </search:SearchInput.KeyboardAccelerators>
            </search:SearchInput>
        </TitleBar>

        <!-- Each item's Tag is the key of its page in MainWindow.Pages. -->
        <shellControls:SmoothNavigationView
            x:Name="navView"
            Grid.Row="1"
            AutoCollapseWidth="{x:Bind shell:WindowSizes.Compact}"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneFooter>
                <Border
                    x:Name="toolsWarning"
                    AutomationProperties.Name="Missing tools"
                    Margin="4,4,4,6"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Missing tools" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind Settings.MissingToolsMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            MinWidth="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Install missing tools"
                            Command="{x:Bind Settings.InstallMissingToolsCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Install missing tools">
                            <Grid>
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    MinWidth="0"
                                    MinHeight="0"
                                    IsActive="{x:Bind Settings.AreToolsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind Settings.AreToolsBusy, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="13"
                                    Glyph="&#xE896;"
                                    Visibility="{x:Bind Settings.AreToolsIdle, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        </Grid>
                </Border>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Icon="Find" Tag="Search" />
                <NavigationViewItem Content="Export" Icon="Download" Tag="Export" />
                <!-- The History glyph isn't in the Symbol enum, so it's given by its code in the icon font. -->
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="activityIcon" Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="activityBadge"
                            DataContext="{x:Bind Activity}"
                            Style="{StaticResource ProgressBadgeStyle}"
                            Visibility="{x:Bind Activity.HasActive, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <!-- The media opened lately is listed after this, by ShowRecentlyViewed. -->
                <NavigationViewItemHeader
                    x:Name="viewedHeader"
                    controls:VisibilityTransition.Slide="True"
                    Content="Recently viewed" />
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame" />
        </shellControls:SmoothNavigationView>
    </Grid>
</Window>
