<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="titleBar"
            Title="MediaExport"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/App/Square44x44Logo.targetsize-24_altform-unplated.png" />
            </TitleBar.IconSource>

            <Grid MaxWidth="600" Margin="16,0" VerticalAlignment="Center" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DropDownButton
                    Height="32"
                    Padding="8,0,6,0"
                    AutomationProperties.Name="Search source"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="{Binding SelectedProvider.DisplayName}">
                    <Image
                        Width="16"
                        Height="16"
                        Source="{Binding SelectedProvider.Id, Converter={StaticResource IconImageConverter}}" />
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="providerMenu" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Grid Grid.Column="1">
                    <AutoSuggestBox
                        x:Name="searchBox"
                        AutomationProperties.Name="Search"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding Suggestions}"
                        IsSuggestionListOpen="{Binding IsSuggestionListOpen, Mode=TwoWay}"
                        TextMemberPath="Title"
                        PlaceholderText="{Binding SearchPlaceholder}"
                        QueryIcon="Find"
                        GotFocus="SearchBox_GotFocus"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted">
                        <AutoSuggestBox.TextBoxStyle>
                            <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                                <Setter Property="IsSpellCheckEnabled" Value="False" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <media:CompactMediaView Media="{Binding}" />
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- Replaces the box's bottom stroke while searching. -->
                    <ProgressBar
                        Margin="1,0"
                        VerticalAlignment="Bottom"
                        CornerRadius="0,0,4,4"
                        IsHitTestVisible="False"
                        IsIndeterminate="{Binding IsSearching}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </TitleBar>

        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Tag="Export">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{Binding ActiveExportCount}"
                            Visibility="{Binding HasActiveExports, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame" />
        </NavigationView>

        <TeachingTip
            x:Name="errorTip"
            Title="Search didn't work"
            Target="{x:Bind searchBox}"
            Subtitle="{Binding ErrorMessage}"
            IsOpen="{Binding HasError, Mode=OneWay}"
            CloseButtonClick="ErrorTip_CloseButtonClick" />
    </Grid>
</Window>
