<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Shortcuts that work on every page; Ctrl+, is added in code (it has no named key). Settings lists them all. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="K"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number1"
                Invoked="GoTo_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="GoTo_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="titleBar"
            Title="MediaExport"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/App/Square44x44Logo.targetsize-24_altform-unplated.png" />
            </TitleBar.IconSource>

            <Grid MaxWidth="600" Margin="16,0" VerticalAlignment="Center" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="providerBox"
                    Height="32"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search source"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    DropDownClosed="ProviderBox_DropDownClosed"
                    DropDownOpened="ProviderBox_DropDownOpened"
                    ItemsSource="{Binding Providers}"
                    SelectedItem="{Binding SelectedProvider, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image
                                    Width="20"
                                    Height="20"
                                    Source="{Binding Id, Converter={StaticResource IconImageConverter}}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Grid.Column="1">
                    <AutoSuggestBox
                        x:Name="searchBox"
                        AutomationProperties.Name="Search"
                        Loaded="SearchBox_Loaded"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding Suggestions}"
                        IsSuggestionListOpen="{Binding IsSuggestionListOpen, Mode=TwoWay}"
                        TextMemberPath="Media.Title"
                        PlaceholderText="{Binding SearchPlaceholder}"
                        QueryIcon="Find"
                        GotFocus="SearchBox_GotFocus"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted">
                        <AutoSuggestBox.TextBoxStyle>
                            <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                                <Setter Property="IsSpellCheckEnabled" Value="False" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <media:CompactMediaView Media="{Binding Media}" />
                                    <FontIcon
                                        Grid.Column="1"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE81C;"
                                        ToolTipService.ToolTip="Recent"
                                        Visibility="{Binding IsRecent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- Replaces the box's bottom stroke while searching. -->
                    <ProgressBar
                        Margin="1,0"
                        VerticalAlignment="Bottom"
                        CornerRadius="0,0,4,4"
                        IsHitTestVisible="False"
                        IsIndeterminate="{Binding IsSearching}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </TitleBar>

        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Tag="Export">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            Value="{Binding ActiveExportCount}"
                            Visibility="{Binding HasActiveExports, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- NavigationView snaps its content to the new size while the pane animates, and Microsoft won't fix it
                     (microsoft-ui-xaml#9370, #5561). Sliding the content's position with the pane hides most of the jump. -->
                <Grid.Transitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </Grid.Transitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="toolsBanner"
                    Title="Some tools are missing"
                    Margin="24,16,24,0"
                    IsClosable="False"
                    IsOpen="{Binding HasMissingTools}"
                    Message="{Binding MissingTools}"
                    Severity="Warning"
                    Visibility="{Binding HasMissingTools, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <InfoBar.ActionButton>
                        <Button Click="SetUpTools_Click" Content="Set up" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="navFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <TeachingTip
            x:Name="errorTip"
            Title="Search didn't work"
            Target="{x:Bind searchBox}"
            Subtitle="{Binding ErrorMessage}"
            IsOpen="{Binding HasError, Mode=OneWay}"
            CloseButtonClick="ErrorTip_CloseButtonClick" />
    </Grid>
</Window>
