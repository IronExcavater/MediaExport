<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:providers="using:MediaExport.Core.Media.Providers"
    xmlns:search="using:MediaExport.Search"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="root"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        Loaded="Root_Loaded">
        <Grid.Resources>
            <!-- Its DataContext is the activity: the ring is the running exports' progress, the number how many. -->
            <Style x:Key="ProgressBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="InfoBadge">
                            <Grid Width="24" Height="24">
                                <ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="{Binding IsRunningProgressUnknown}"
                                    Value="{Binding RunningProgress}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding RunningCount}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <!-- The app's own icon and name, larger than the title bar's caption-sized title and centred together. -->
            <TitleBar.LeftHeader>
                <StackPanel
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-24_altform-unplated.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="MediaExport" />
                </StackPanel>
            </TitleBar.LeftHeader>

            <Grid
                MaxWidth="640"
                Margin="16,0"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    MinWidth="196"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Search source"
                    DropDownClosed="ProviderBox_DropDownClosed"
                    DropDownOpened="ProviderBox_DropDownOpened"
                    ItemsSource="{x:Bind Search.Providers}"
                    SelectedItem="{x:Bind Search.SelectedProvider, Mode=OneWay}"
                    SelectionChanged="ProviderBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="providers:IMediaSearchProvider">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconView
                                    Width="24"
                                    Height="24"
                                    Icon="{x:Bind Icon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind DisplayName}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Grid.Column="1">
                    <AutoSuggestBox
                        x:Name="searchBox"
                        AutomationProperties.Name="Search"
                        GotFocus="SearchBox_GotFocus"
                        IsSuggestionListOpen="{x:Bind Search.IsSuggestionListOpen, Mode=TwoWay}"
                        ItemsSource="{x:Bind Search.Suggestions}"
                        Loaded="SearchBox_Loaded"
                        PlaceholderText="{x:Bind Search.Placeholder, Mode=OneWay}"
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        Text="{x:Bind Search.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="SearchBox_TextChanged"
                        TextMemberPath="Query">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="K"
                                Invoked="FocusSearch_Invoked"
                                Modifiers="Control" />
                        </AutoSuggestBox.KeyboardAccelerators>
                        <AutoSuggestBox.TextBoxStyle>
                            <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                                <Setter Property="IsSpellCheckEnabled" Value="False" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="search:SearchSuggestion">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <media:CompactMediaView Media="{x:Bind Media}" Visibility="{x:Bind converters:Show.Unless(IsMessage)}" />
                                    <TextBlock
                                        Padding="0,8"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Message}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsMessage}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE81C;"
                                            ToolTipService.ToolTip="Picked recently"
                                            Visibility="{x:Bind IsRecent}" />
                                        <!-- Where it's from, when every source is searched together. -->
                                        <controls:IconView
                                            Width="18"
                                            Height="18"
                                            Source="{x:Bind Media.ProviderId}"
                                            Visibility="{x:Bind ShowSource}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <!-- Over the box's bottom stroke while searching, so nothing moves. -->
                    <ProgressBar
                        Margin="1,0"
                        VerticalAlignment="Bottom"
                        CornerRadius="0,0,4,4"
                        IsHitTestVisible="False"
                        IsIndeterminate="{x:Bind Search.IsSearching, Mode=OneWay}"
                        Visibility="{x:Bind Search.IsSearching, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="2"
                    Height="32"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sort results"
                    ToolTipService.ToolTip="Sort results">
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    <Button.Flyout>
                        <MenuFlyout
                            Closed="SortMenu_Closed"
                            Opening="SortMenu_Opening"
                            Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem
                                Click="Sort_Click"
                                GroupName="Sort"
                                Tag="Relevance"
                                Text="Best match" />
                            <RadioMenuFlyoutItem
                                Click="Sort_Click"
                                GroupName="Sort"
                                Tag="Popularity"
                                Text="Most played" />
                            <RadioMenuFlyoutItem
                                Click="Sort_Click"
                                GroupName="Sort"
                                Tag="Recency"
                                Text="Newest" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </TitleBar>

        <!-- The pane stays open in code and its width is animated, so pages resize smoothly with it. -->
        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Tag="Export">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Number1"
                            Invoked="GoTo_Invoked"
                            Modifiers="Control" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <!-- How many are running, inside a ring showing how far they've got together. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            DataContext="{x:Bind Activity}"
                            Style="{StaticResource ProgressBadgeStyle}"
                            Visibility="{x:Bind Activity.HasRunning, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Number2"
                            Invoked="GoTo_Invoked"
                            Modifiers="Control" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
            </NavigationView.MenuItems>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Title="Almost ready"
                    Margin="24,12,24,0"
                    IsClosable="False"
                    IsOpen="{x:Bind Settings.HasMissingTools, Mode=OneWay}"
                    Message="{x:Bind Settings.MissingTools, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind Settings.HasMissingTools, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind Settings.InstallMissingToolsCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    IsActive="{x:Bind Settings.IsInstallingMissing, Mode=OneWay}"
                                    Visibility="{x:Bind Settings.IsInstallingMissing, Mode=OneWay}" />
                                <TextBlock Text="Install them" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="navFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
