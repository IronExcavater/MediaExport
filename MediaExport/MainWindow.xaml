<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <!-- The app's own icon and name, larger than the title bar's caption-sized title and centred together. -->
            <TitleBar.LeftHeader>
                <StackPanel
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-24_altform-unplated.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="MediaExport" />
                </StackPanel>
            </TitleBar.LeftHeader>

            <AutoSuggestBox
                MaxWidth="640"
                Margin="16,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search"
                PlaceholderText="Search"
                QueryIcon="Find" />
        </TitleBar>

        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Tag="Export">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame" />
        </NavigationView>
    </Grid>
</Window>
