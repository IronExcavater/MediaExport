<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:MediaExport.Shell"
    xmlns:search="using:MediaExport.Search"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The app shell has the title bar on top, the navigation pane on the left, and the selected page beside it. -->
    <Grid x:Name="root" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
            SizeChanged="TitleBar_SizeChanged">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <!-- The window can still be dragged by the app header, so no extra drag area is needed beside the search. -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>

            <!-- Used instead of TitleBar's Icon and Title, which are fixed at a smaller caption size. -->
            <TitleBar.LeftHeader>
                <!-- MinWidth is the logo's width, which stops the search field sliding over the logo. -->
                <StackPanel
                    MinWidth="22"
                    Margin="4,0,0,0"
                    Orientation="Horizontal">
                    <!--
                        Narrowing the app name's grid hides the name, and the search field follows because
                        the width is part of the layout. The storyboards find the grid by name, which only
                        works from resources this close to it.
                    -->
                    <StackPanel.Resources>
                        <CubicEase x:Key="SlideEase" EasingMode="EaseInOut" />
                        <Storyboard x:Name="hideAppName">
                            <DoubleAnimation
                                EasingFunction="{StaticResource SlideEase}"
                                EnableDependentAnimation="True"
                                Storyboard.TargetName="appName"
                                Storyboard.TargetProperty="MaxWidth"
                                To="0"
                                Duration="0:0:0.4" />
                        </Storyboard>
                        <Storyboard x:Name="showAppName">
                            <DoubleAnimation
                                x:Name="showAppNameWidth"
                                EasingFunction="{StaticResource SlideEase}"
                                EnableDependentAnimation="True"
                                Storyboard.TargetName="appName"
                                Storyboard.TargetProperty="MaxWidth"
                                Duration="0:0:0.4" />
                        </Storyboard>
                    </StackPanel.Resources>

                    <!--
                        The logo is drawn over the app name, and its negative margin starts the name's grid
                        at the logo's middle, so that is where the name is cut off as it slides away.
                    -->
                    <Image
                        Height="22"
                        Margin="0,0,-11,0"
                        VerticalAlignment="Center"
                        Canvas.ZIndex="1"
                        Source="{StaticResource AppLogo}" />

                    <!--
                        The StackPanel keeps the name at full width, so it overflows the narrowing grid and
                        is cut off. An overflowing element is held at its parent's start, which is the right
                        edge of a right-to-left grid, so the name slides left as the grid narrows.
                    -->
                    <Grid x:Name="appName" FlowDirection="RightToLeft">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="appNameText"
                                Padding="21,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="MediaExport" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TitleBar.LeftHeader>

            <search:SearchInput
                x:Name="searchInput"
                Margin="4,0"
                Submitted="SearchInput_Submitted"
                ViewModel="{x:Bind Search}">
                <search:SearchInput.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="K"
                        Invoked="FocusSearch_Invoked"
                        Modifiers="Control" />
                </search:SearchInput.KeyboardAccelerators>
            </search:SearchInput>
        </TitleBar>

        <!-- Each item's Tag is the key of its page in MainWindow.Pages. -->
        <shell:SmoothNavigationView
            x:Name="navView"
            Grid.Row="1"
            AutoCollapseWidth="{x:Bind shell:WindowSizes.Compact}"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Icon="Find" Tag="Search" />
                <NavigationViewItem Content="Export" Icon="Download" Tag="Export" />
                <!-- The History glyph isn't in the Symbol enum, so it's given by its code in the icon font. -->
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame" />
        </shell:SmoothNavigationView>
    </Grid>
</Window>
