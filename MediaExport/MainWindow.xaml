<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:MediaExport.Shell"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- The shell: the title bar across the top, the pages' names down the side, and the page that's chosen. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <!-- The app's own icon and name, larger than the title bar's caption-sized title and centred together. -->
            <TitleBar.LeftHeader>
                <StackPanel
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Source="{StaticResource AppLogo}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="MediaExport" />
                </StackPanel>
            </TitleBar.LeftHeader>

            <AutoSuggestBox
                MaxWidth="640"
                Margin="16,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search"
                PlaceholderText="Search"
                QueryIcon="Find" />
        </TitleBar>

        <!-- Each item's Tag is its page's name in MainWindow.Pages. -->
        <shell:SmoothNavigationView
            x:Name="navView"
            Grid.Row="1"
            CollapseDuration="0:0:0.18"
            CollapsedPaneLength="50"
            ExpandDuration="0:0:0.25"
            ExpandedPaneLength="240"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Icon="Download" Tag="Export" />
                <NavigationViewItem Content="Search" Icon="Find" Tag="Search" />
                <!-- The history clock has no name among the symbols, so it's given as its character in the icon font. -->
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="navFrame" />
        </shell:SmoothNavigationView>
    </Grid>
</Window>
