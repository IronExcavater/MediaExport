<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaExport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:providers="using:MediaExport.Core.Media.Providers"
    xmlns:search="using:MediaExport.Search"
    Title="MediaExport">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="root"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        Loaded="Root_Loaded">
        <Grid.Resources>
            <!-- Its DataContext is the activity: the ring is the running exports' progress, the number how many. -->
            <Style x:Key="ProgressBadgeStyle" TargetType="InfoBadge">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="InfoBadge">
                            <Grid Width="24" Height="24">
                                <ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="{Binding IsRunningProgressUnknown}"
                                    Value="{Binding RunningProgress}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding RunningCount}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <!-- The app's own icon and name, larger than the title bar's caption-sized title and centred together. -->
            <TitleBar.LeftHeader>
                <!-- As wide as the open pane beside the toggle, so the search starts level with the pages below. -->
                <StackPanel
                    x:Name="appHeader"
                    Width="182"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Image
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-24_altform-unplated.png" />
                    <TextBlock
                        x:Name="appName"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="MediaExport" />
                </StackPanel>
            </TitleBar.LeftHeader>

            <!-- One fixed-height field owns provider, structured terms, words, add and sort actions. -->
            <search:SearchInput
                x:Name="searchInput"
                Margin="24,0,16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                MediaChosen="SearchInput_MediaChosen"
                Results="{x:Bind Results}"
                Submitted="SearchInput_Submitted"
                ViewModel="{x:Bind Search}">
                <search:SearchInput.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="K"
                        Invoked="FocusSearch_Invoked"
                        Modifiers="Control" />
                </search:SearchInput.KeyboardAccelerators>
            </search:SearchInput>
        </TitleBar>

        <!-- The pane stays open while only its width changes, keeping the page bounds continuous during animation. -->
        <NavigationView
            x:Name="navView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Export" Tag="Export">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Number1"
                            Invoked="GoTo_Invoked"
                            Modifiers="Control" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Number2"
                            Invoked="GoTo_Invoked"
                            Modifiers="Control" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                    <!-- How many are running, inside a ring showing how far they've got together. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            DataContext="{x:Bind Activity}"
                            Style="{StaticResource ProgressBadgeStyle}"
                            Visibility="{x:Bind Activity.HasRunning, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="Number3"
                            Invoked="GoTo_Invoked"
                            Modifiers="Control" />
                    </NavigationViewItem.KeyboardAccelerators>
                </NavigationViewItem>
            </NavigationView.MenuItems>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    Title="Almost ready"
                    Margin="24,12,24,0"
                    IsClosable="False"
                    IsOpen="{x:Bind Settings.HasMissingTools, Mode=OneWay}"
                    Message="{x:Bind Settings.MissingTools, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind Settings.HasMissingTools, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Command="{x:Bind Settings.InstallMissingToolsCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    IsActive="{x:Bind Settings.IsInstallingMissing, Mode=OneWay}"
                                    Visibility="{x:Bind Settings.IsInstallingMissing, Mode=OneWay}" />
                                <TextBlock Text="Install them" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="navFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!--
            As the window narrows, the title bar keeps the complete compact search control and lets go of the app name.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1240" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="MediumBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowBar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="appName.Visibility" Value="Collapsed" />
                        <Setter Target="appHeader.Width" Value="Auto" />
                        <Setter Target="searchInput.Margin" Value="12,0,12,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Window>
