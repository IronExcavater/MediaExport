<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="PageFadeColor">#FF202020</Color>
            <Color x:Key="ControlFadeColor">#FF2D2D2D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PageFadeColor">#FFF3F3F3</Color>
            <Color x:Key="ControlFadeColor">#FFFBFBFB</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- A stable app palette rather than a Windows accent that may be too pale for selected controls. -->
    <Color x:Key="SystemAccentColor">#14A596</Color>
    <Color x:Key="SystemAccentColorLight1">#37C2B3</Color>
    <Color x:Key="SystemAccentColorLight2">#5FD6C8</Color>
    <Color x:Key="SystemAccentColorLight3">#9BE9DF</Color>
    <Color x:Key="SystemAccentColorDark1">#0E8579</Color>
    <Color x:Key="SystemAccentColorDark2">#09675E</Color>
    <Color x:Key="SystemAccentColorDark3">#054A44</Color>

    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
    <x:Double x:Key="PageMaxWidth">1200</x:Double>
    <x:Double x:Key="InlineControlHeight">32</x:Double>

    <LinearGradientBrush x:Key="TopPageFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{ThemeResource PageFadeColor}" />
        <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomPageFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="Transparent" />
        <GradientStop Offset="1" Color="{ThemeResource PageFadeColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LeftControlFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{ThemeResource ControlFadeColor}" />
        <GradientStop Offset="1" Color="Transparent" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RightControlFadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="Transparent" />
        <GradientStop Offset="1" Color="{ThemeResource ControlFadeColor}" />
    </LinearGradientBrush>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionTitleStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock" />
    <Style x:Key="EmptyStateTitleStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="SplitButton">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}" />
    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="InlineIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="InlineActionButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="DividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
        <controls:WrapPanel />
    </ItemsPanelTemplate>
</ResourceDictionary>
