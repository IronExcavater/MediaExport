<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's brand icons, one for every file in Assets/Icons/Brands. Each is a style for an ImageIcon:
        <ImageIcon Style="{StaticResource YouTubeIcon}" />
    To add an icon, put its file in that folder and add a style for it here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Single-colour logos come as two files: name.dark.svg for the dark theme and name.light.svg for the
        light theme. They are listed here by theme, and their styles below pick one with {ThemeResource}.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SvgImageSource x:Key="DailymotionIconSource" UriSource="ms-appx:///Assets/Icons/Brands/dailymotion.dark.svg" />
            <SvgImageSource x:Key="InternetArchiveIconSource" UriSource="ms-appx:///Assets/Icons/Brands/internet-archive.dark.svg" />
            <SvgImageSource x:Key="NiconicoIconSource" UriSource="ms-appx:///Assets/Icons/Brands/niconico.dark.svg" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="DailymotionIconSource" UriSource="ms-appx:///Assets/Icons/Brands/dailymotion.light.svg" />
            <SvgImageSource x:Key="InternetArchiveIconSource" UriSource="ms-appx:///Assets/Icons/Brands/internet-archive.light.svg" />
            <SvgImageSource x:Key="NiconicoIconSource" UriSource="ms-appx:///Assets/Icons/Brands/niconico.light.svg" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Media sources -->
    <Style x:Key="BilibiliIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/bilibili.svg" />
    </Style>
    <Style x:Key="DailymotionIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="{ThemeResource DailymotionIconSource}" />
    </Style>
    <Style x:Key="InternetArchiveIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="{ThemeResource InternetArchiveIconSource}" />
    </Style>
    <Style x:Key="MixcloudIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/mixcloud.svg" />
    </Style>
    <Style x:Key="NiconicoIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="{ThemeResource NiconicoIconSource}" />
    </Style>
    <Style x:Key="SoundCloudIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/soundcloud.svg" />
    </Style>
    <Style x:Key="VimeoIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/vimeo.svg" />
    </Style>
    <Style x:Key="YouTubeIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/youtube.svg" />
    </Style>
    <Style x:Key="YouTubeMusicIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/youtube-music.svg" />
    </Style>

    <!-- Browsers -->
    <Style x:Key="BraveIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/brave.svg" />
    </Style>
    <Style x:Key="ChromeIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/google-chrome.svg" />
    </Style>
    <Style x:Key="EdgeIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/microsoft-edge.svg" />
    </Style>
    <Style x:Key="FirefoxIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/mozilla-firefox.svg" />
    </Style>
    <Style x:Key="OperaIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/opera.svg" />
    </Style>
    <Style x:Key="VivaldiIcon" TargetType="ImageIcon">
        <Setter Property="Source" Value="ms-appx:///Assets/Icons/Brands/vivaldi.svg" />
    </Style>

    <!-- The app's own logo, shown in the title bar. -->
    <BitmapImage x:Key="AppLogo" UriSource="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
</ResourceDictionary>
