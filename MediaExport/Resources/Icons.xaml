<?xml version="1.0" encoding="utf-8"?>
<!--
    Every image the app ships, as a named resource, so no other file needs a path:
        <Image Source="{ThemeResource DailymotionIcon}" />
    Use ThemeResource, not StaticResource, so icons with separate light and dark versions follow the theme.
    To add an icon, put the file under Assets/Icons and add a line here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- Single-colour logos, with a light version for the dark theme and a dark version for the light theme. -->
        <ResourceDictionary x:Key="Default">
            <SvgImageSource x:Key="DailymotionIcon" UriSource="ms-appx:///Assets/Icons/Brands/dailymotion.dark.svg" />
            <SvgImageSource x:Key="InternetArchiveIcon" UriSource="ms-appx:///Assets/Icons/Brands/internet-archive.dark.svg" />
            <SvgImageSource x:Key="NiconicoIcon" UriSource="ms-appx:///Assets/Icons/Brands/niconico.dark.svg" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="DailymotionIcon" UriSource="ms-appx:///Assets/Icons/Brands/dailymotion.light.svg" />
            <SvgImageSource x:Key="InternetArchiveIcon" UriSource="ms-appx:///Assets/Icons/Brands/internet-archive.light.svg" />
            <SvgImageSource x:Key="NiconicoIcon" UriSource="ms-appx:///Assets/Icons/Brands/niconico.light.svg" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Full-colour logos that work on both themes. -->
    <SvgImageSource x:Key="BilibiliIcon" UriSource="ms-appx:///Assets/Icons/Brands/bilibili.svg" />
    <SvgImageSource x:Key="MixcloudIcon" UriSource="ms-appx:///Assets/Icons/Brands/mixcloud.svg" />
    <SvgImageSource x:Key="SoundCloudIcon" UriSource="ms-appx:///Assets/Icons/Brands/soundcloud.svg" />
    <SvgImageSource x:Key="VimeoIcon" UriSource="ms-appx:///Assets/Icons/Brands/vimeo.svg" />
    <SvgImageSource x:Key="YouTubeIcon" UriSource="ms-appx:///Assets/Icons/Brands/youtube.svg" />
    <SvgImageSource x:Key="YouTubeMusicIcon" UriSource="ms-appx:///Assets/Icons/Brands/youtube-music.svg" />

    <!-- Browsers, for choosing which browser's sign-in cookies to use. -->
    <SvgImageSource x:Key="BraveIcon" UriSource="ms-appx:///Assets/Icons/Brands/brave.svg" />
    <SvgImageSource x:Key="ChromeIcon" UriSource="ms-appx:///Assets/Icons/Brands/google-chrome.svg" />
    <SvgImageSource x:Key="EdgeIcon" UriSource="ms-appx:///Assets/Icons/Brands/microsoft-edge.svg" />
    <SvgImageSource x:Key="FirefoxIcon" UriSource="ms-appx:///Assets/Icons/Brands/mozilla-firefox.svg" />
    <SvgImageSource x:Key="OperaIcon" UriSource="ms-appx:///Assets/Icons/Brands/opera.svg" />
    <SvgImageSource x:Key="VivaldiIcon" UriSource="ms-appx:///Assets/Icons/Brands/vivaldi.svg" />

    <BitmapImage x:Key="AppLogo" UriSource="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
</ResourceDictionary>
