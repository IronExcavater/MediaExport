<?xml version="1.0" encoding="utf-8"?>
<!-- The app's colours. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="using:System">
    <!--
        The app always uses the logo's cyan as its accent, instead of the user's Windows accent colour,
        because a grey or pale system accent makes selected controls hard to read.
        WinUI uses the Light2 shade on the dark theme and Dark1 on the light theme.
    -->
    <SolidColorBrush x:Key="SystemAccentColor" Color="#14A596" />
    <SolidColorBrush x:Key="SystemAccentColorLight1" Color="#37C2B3" />
    <SolidColorBrush x:Key="SystemAccentColorLight2" Color="#5FD6C8" />
    <SolidColorBrush x:Key="SystemAccentColorLight3" Color="#9BE9DF" />
    <SolidColorBrush x:Key="SystemAccentColorDark1" Color="#0E8579" />
    <SolidColorBrush x:Key="SystemAccentColorDark2" Color="#09675E" />
    <SolidColorBrush x:Key="SystemAccentColorDark3" Color="#054A44" />
</ResourceDictionary>
