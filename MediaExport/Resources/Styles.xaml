<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes and styles shared by all pages. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Page content stops growing at this width and is centred instead. -->
    <x:Double x:Key="PageMaxWidth">1400</x:Double>

    <Thickness x:Key="PagePadding">24,12,24,24</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

    <Style x:Key="PageTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock" />

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="SplitButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!-- A bordered surface that groups related content. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The thin vertical line between the parts of a combined field, such as the search field. -->
    <Style x:Key="FieldDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="1" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- The box has no background or border to round, so this only rounds its clear button. -->
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="Padding" Value="10,7,4,7" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        A button inside a field such as the search field. It is set in from the field's edges and rounded,
        and takes its height from the field, so every button in a field looks and sizes the same.
    -->
    <Style x:Key="FieldButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- A field button that holds only an icon, so it is square. -->
    <Style x:Key="FieldIconButtonStyle" BasedOn="{StaticResource FieldButtonStyle}" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="30" />
    </Style>

    <Style x:Key="FieldIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SecondaryTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
