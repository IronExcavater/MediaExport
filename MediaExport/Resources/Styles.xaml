<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Page content stops growing at this width and is centred instead. -->
    <x:Double x:Key="PageMaxWidth">1400</x:Double>

    <Thickness x:Key="PagePadding">24,12,24,24</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>

    <Style x:Key="PageTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock" />

    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="SplitButton">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style TargetType="AutoSuggestBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!-- A bordered panel for a group of related content. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The line between the parts of a field. -->
    <Style x:Key="FieldDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="1" />
    </Style>

    <Style x:Key="SearchTextBoxStyle" BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <!-- The extra top padding lines the text up with the labels beside it. -->
        <Setter Property="Padding" Value="6,8,6,6" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- A card's button is see-through until hovered, like a ListView item. -->
    <Style x:Key="CardButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- A bar standing in for a line of text in a skeleton. -->
    <Style x:Key="SkeletonBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A button for stepping through pages. -->
    <Style x:Key="PageButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
    </Style>

    <!--
        A field button that holds only an icon. Its size and the gaps around it in a field are multiples of 4, which
        come to whole pixels at 125% and 150% display scale, so the buttons sit evenly however the field is placed.
    -->
    <Style x:Key="FieldIconButtonStyle" BasedOn="{StaticResource FieldButtonStyle}" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
    </Style>

    <!-- A small square button at the end of a row in a list. -->
    <Style x:Key="RowIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="24" />
    </Style>

    <Style x:Key="FieldIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SecondaryTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Style for each settings item card. -->
    <Style x:Key="SettingsItemStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="MinHeight" Value="70" />
    </Style>

    <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,20,0,5"/>
    </Style>

    <Style x:Key="SettingsItemDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
</ResourceDictionary>
