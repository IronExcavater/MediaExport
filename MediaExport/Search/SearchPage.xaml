<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <!-- 12 less side padding and a 12 heading inset leave room for the cards' focus ring. -->
    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="12,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,0,16,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        AutomationProperties.Name="Previous page"
                        Command="{x:Bind ViewModel.PreviousPageCommand}"
                        Style="{StaticResource PageButtonStyle}"
                        ToolTipService.ToolTip="Previous page">
                        <FontIcon Glyph="&#xE76B;" Style="{StaticResource FieldIconStyle}" />
                    </Button>

                    <!--
                        The page that is showing, and a box to type another in. It looks like an accent button until
                        it has focus, when it is an ordinary text box: only the colours a TextBox has at rest and
                        under the pointer are replaced. TextWrapping is Wrap only because a wrapping TextBox has
                        no delete button, which would cover a box this narrow.
                    -->
                    <TextBox
                        x:Name="pageBox"
                        Width="32"
                        Height="28"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0,3,0,4"
                        AutomationProperties.Name="Page"
                        BeforeTextChanging="PageBox_BeforeTextChanging"
                        GotFocus="PageBox_GotFocus"
                        InputScope="Number"
                        KeyDown="PageBox_KeyDown"
                        LostFocus="PageBox_LostFocus"
                        MaxLength="3"
                        Text="{x:Bind ViewModel.Page, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="Go to page">
                        <TextBox.Resources>
                            <!-- Parts of TextBox's template are held to these sizes as well as the box itself. -->
                            <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                            <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                            <StaticResource x:Key="TextControlBackground" ResourceKey="AccentFillColorDefaultBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="TextControlForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AccentControlElevationBorderBrush" />
                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AccentControlElevationBorderBrush" />
                        </TextBox.Resources>
                    </TextBox>

                    <Button
                        AutomationProperties.Name="Next page"
                        Command="{x:Bind ViewModel.NextPageCommand}"
                        Style="{StaticResource PageButtonStyle}"
                        ToolTipService.ToolTip="Next page">
                        <FontIcon Glyph="&#xE76C;" Style="{StaticResource FieldIconStyle}" />
                    </Button>
                </StackPanel>

                <!-- Which results are showing, or why there are none. MinHeight keeps its room while it is empty. -->
                <TextBlock
                    MinHeight="16"
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <controls:EdgeFade Grid.Row="1">
            <!-- Anchoring is off (NaN), as it left the page part-way down when a search replaced the results. -->
            <ScrollViewer
                x:Name="resultsScroll"
                controls:ScrollBarGutter.Mode="Auto"
                VerticalAnchorRatio="NaN">
                <Grid Margin="4">
                    <!-- Skeleton cards in the same grid while a page loads, so the results fill in without a jump. -->
                    <ItemsRepeater x:Name="skeletons" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <controls:JustifiedLayout ItemPadding="16" RowHeight="150" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:Double">
                                <!-- The padding a card's button gives it. -->
                                <Border Padding="8" controls:JustifiedLayout.Shape="{x:Bind}">
                                    <media:CardMediaView PlaceholderShape="{x:Bind}" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- The arrow keys move between the cards, to whichever is nearest in that direction. -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results}" XYFocusKeyboardNavigation="Enabled">
                        <!-- The cards need no spacing, because each one's button has padding of its own, which ItemPadding is. -->
                        <ItemsRepeater.Layout>
                            <controls:JustifiedLayout ItemPadding="16" RowHeight="150" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaSearchResult">
                                <Button
                                    controls:JustifiedLayout.Shape="{x:Bind media:MediaThumbnail.ShapeOf(Kind)}"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    Click="Result_Click"
                                    Style="{StaticResource CardButtonStyle}"
                                    Tag="{x:Bind}">
                                    <media:CardMediaView Media="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </controls:EdgeFade>
    </Grid>
</Page>
