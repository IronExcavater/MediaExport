<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A result is one big button with nothing of a button's look until it's pointed at. -->
        <Style x:Key="ResultButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!--
            A source to search: quiet until picked, then tinted and ringed in the accent colour. A solid accent
            fill would drown the sources' own icons, and a row of nine of them would shout.
        -->
        <Style x:Key="SourcePillStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                x:Name="Tint"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.2" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.28" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.14" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="24,16,24,0"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What was searched, and how much came back. The order is the title bar's to set. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Margin="0,0,0,3"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
        </StackPanel>

        <!--
            Where to look, in place of the title bar's one source: everywhere, or just the sources picked.
            They wrap onto another line when the window's too narrow for one. Each keeps room for its count,
            so the row doesn't reflow as results arrive.
        -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton
                VerticalAlignment="Top"
                AutomationProperties.Name="Every source"
                Click="EverySource_Click"
                IsChecked="{x:Bind ViewModel.IsEverySource, Mode=OneWay}"
                Style="{StaticResource SourcePillStyle}"
                ToolTipService.ToolTip="Search every source">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                    <TextBlock Text="Everywhere" />
                </StackPanel>
            </ToggleButton>
            <Rectangle
                Grid.Column="1"
                Width="1"
                Height="22"
                Margin="0,6"
                VerticalAlignment="Top"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid Grid.Column="2">
                <ItemsControl
                    Margin="0,0,0,-8"
                    ItemsPanel="{StaticResource WrapPanelTemplate}"
                    ItemsSource="{x:Bind ViewModel.Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SourceFilter">
                            <ToggleButton
                                Margin="0,0,8,8"
                                AutomationProperties.Name="{x:Bind Provider.DisplayName}"
                                IsChecked="{x:Bind IsPicked, Mode=TwoWay}"
                                Style="{StaticResource SourcePillStyle}"
                                ToolTipService.ToolTip="Search just the sources picked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:IconView
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Icon="{x:Bind Provider.Icon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Provider.DisplayName}" />
                                    <!-- How many of the results on the page are this source's. -->
                                    <TextBlock
                                        MinWidth="14"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Count, Mode=OneWay}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <ProgressBar
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            Margin="0,72,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- A feed of cards, as many across as fit; their size is set in code so every picture is exactly 16:9. -->
        <ScrollViewer
            x:Name="scroller"
            Grid.Row="2"
            Margin="-8,4,-8,0"
            SizeChanged="Scroller_SizeChanged">
            <ItemsRepeater Margin="0,0,0,24" ItemsSource="{x:Bind ViewModel.Results}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="feed"
                        MinColumnSpacing="4"
                        MinItemHeight="260"
                        MinItemWidth="300"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaSearchResult">
                        <Button
                            AutomationProperties.Name="{x:Bind}"
                            Click="Result_Click"
                            Style="{StaticResource ResultButtonStyle}"
                            Tag="{x:Bind}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="84" />
                                </Grid.RowDefinitions>

                                <!--
                                    The picture, whole, over a dimmed copy of itself filling the frame: a 16:9 one covers
                                    the copy entirely, and a square cover sits in the middle with its own colours either side.
                                -->
                                <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                                    <Image Opacity="0.3" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage DecodePixelWidth="96" UriSource="{x:Bind ThumbnailUri}" />
                                        </Image.Source>
                                    </Image>
                                    <Image Stretch="Uniform">
                                        <Image.Source>
                                            <BitmapImage DecodePixelWidth="640" UriSource="{x:Bind ThumbnailUri}" />
                                        </Image.Source>
                                    </Image>
                                    <Border
                                        Margin="8"
                                        Padding="6,2,6,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        CornerRadius="4"
                                        Opacity="0.9"
                                        Visibility="{x:Bind converters:Show.WhenSet(Duration)}">
                                        <TextBlock FontSize="12" Text="{x:Bind converters:Format.Duration(Duration)}" />
                                    </Border>
                                </Grid>

                                <!-- Its source's icon beside what it is, who made it, and how played and how old it is. -->
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconView
                                        Width="28"
                                        Height="28"
                                        Margin="2,2,0,0"
                                        VerticalAlignment="Top"
                                        Source="{x:Bind ProviderId}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Creator}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind converters:Show.WhenText(Creator)}" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind converters:Format.Meta(Views, Published)}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
