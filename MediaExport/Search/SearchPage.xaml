<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!--
            A source to search: quiet until picked, then tinted and ringed in the accent colour. A solid accent
            fill would drown the sources' own icons, and a row of nine of them would shout.
        -->
        <Style x:Key="SourcePillStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <Border
                                x:Name="Tint"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.2" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.28" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Tint.Opacity" Value="0.14" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="24,16,24,0"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What was searched and how much came back; on the right, back to every source in one go. -->
        <Grid MinHeight="40" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Bottom"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Margin="0,0,0,3"
                VerticalAlignment="Bottom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            <!--
                While every source is searched this just says so; once some are left out it becomes the way back.
                A button that's always there would have nothing to do most of the time.
            -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.AreAllPicked, Mode=OneWay}">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE774;" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Searching everywhere" />
            </StackPanel>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.PickAllCommand}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Search every source again"
                Visibility="{x:Bind converters:Show.Unless(ViewModel.AreAllPicked), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                    <TextBlock Text="Search everywhere" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Where to look, in place of the title bar's one source: the sources picked, which to begin with is all of them.
            They wrap onto another line when the window's too narrow for one. Each keeps room for its count,
            so the row doesn't reflow as results arrive.
        -->
        <ItemsControl
            Grid.Row="1"
            Margin="0,0,0,-8"
            ItemsPanel="{StaticResource WrapPanelTemplate}"
            ItemsSource="{x:Bind ViewModel.Sources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SourceFilter">
                    <ToggleButton
                        Margin="0,0,8,8"
                        AutomationProperties.Name="{x:Bind Provider.DisplayName}"
                        IsChecked="{x:Bind IsPicked, Mode=TwoWay}"
                        Style="{StaticResource SourcePillStyle}"
                        ToolTipService.ToolTip="Search just this source, or add it to the ones picked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconView
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Icon="{x:Bind Provider.Icon}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Provider.DisplayName}" />
                            <!-- How many of the results on the page are this source's. -->
                            <TextBlock
                                MinWidth="14"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Count, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ProgressBar
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            Margin="0,72,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            A feed of cards in rows of one height, each card as wide as its picture's shape: 16:9 for video, square for a cover.
        -->
        <ScrollViewer Grid.Row="2" Margin="-8,0,-8,0">
            <ItemsRepeater Margin="0,0,0,24" ItemsSource="{x:Bind ViewModel.Results}">
                <ItemsRepeater.Layout>
                    <media:JustifiedLayout RowHeight="180" Spacing="4" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaSearchResult">
                        <media:MediaCard Chosen="Result_Chosen" Media="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
