<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <!-- 12 less side padding and a 12 heading inset leave room for the cards' focus ring. -->
    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="12,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,0,16,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind converters:VisibleWhen.NotBlank(ViewModel.SearchedQuery), Mode=OneWay}">
                <Button
                    AutomationProperties.Name="Previous page"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Style="{StaticResource PageButtonStyle}"
                    ToolTipService.ToolTip="Previous page">
                    <FontIcon Glyph="&#xE76B;" Style="{StaticResource FieldIconStyle}" />
                </Button>

                <Border
                    Width="32"
                    Height="32"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Page"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.Page, Mode=OneWay}" />
                </Border>

                <Button
                    AutomationProperties.Name="Next page"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Style="{StaticResource PageButtonStyle}"
                    ToolTipService.ToolTip="Next page">
                    <FontIcon Glyph="&#xE76C;" Style="{StaticResource FieldIconStyle}" />
                </Button>
            </StackPanel>
        </Grid>

        <controls:EdgeFade Grid.Row="1">
            <!-- Anchoring is off (NaN), as it left the page part-way down when a search replaced the results. -->
            <ScrollViewer x:Name="resultsScroll" VerticalAnchorRatio="NaN">
                <Grid Margin="4,4,16,4">
                    <!-- Skeleton cards in the same grid while a page loads, so the results fill in without a jump. -->
                    <ItemsRepeater ItemsSource="{x:Bind LoadingSlots}" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <controls:RowGridLayout MinItemWidth="256" MinRowSpacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <!-- The padding a card's button gives it. -->
                                <Border Padding="8">
                                    <media:CardMediaView />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results}">
                        <!-- The spacing is small because each card's button has padding of its own. -->
                        <ItemsRepeater.Layout>
                            <controls:RowGridLayout MinItemWidth="256" MinRowSpacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaSearchResult">
                                <!-- Opening the result belongs in this button's Click. -->
                                <Button AutomationProperties.Name="{x:Bind Title}" Style="{StaticResource CardButtonStyle}">
                                    <media:CardMediaView Media="{x:Bind}" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>
        </controls:EdgeFade>
    </Grid>
</Page>
