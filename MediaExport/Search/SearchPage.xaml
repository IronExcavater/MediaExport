<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A result is one big button with nothing of a button's look until it's pointed at. -->
        <Style x:Key="ResultButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid
        MaxWidth="{StaticResource PageMaxWidth}"
        Padding="24,16,24,0"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- What was searched and how much came back, then what's shown of it and in what order. -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    Visibility="{x:Bind converters:Show.WhenText(ViewModel.Summary), Mode=OneWay}" />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                MinWidth="140"
                VerticalAlignment="Center"
                AutomationProperties.Name="Show"
                Header="Show"
                SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=TwoWay}">
                <x:String>Everything</x:String>
                <x:String>Video</x:String>
                <x:String>Audio</x:String>
            </ComboBox>
            <ComboBox
                Grid.Column="2"
                MinWidth="150"
                VerticalAlignment="Center"
                AutomationProperties.Name="Sort results"
                Header="Sort by"
                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <x:String>Best match</x:String>
                <x:String>Most played</x:String>
                <x:String>Newest</x:String>
            </ComboBox>
        </Grid>

        <!-- Which sources are asked; switching one off searches again without it. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <HyperlinkButton
                    Command="{x:Bind ViewModel.SetAllSourcesCommand}"
                    CommandParameter="True"
                    Content="All"
                    ToolTipService.ToolTip="Search every source" />
                <HyperlinkButton
                    Command="{x:Bind ViewModel.SetAllSourcesCommand}"
                    CommandParameter="False"
                    Content="None"
                    ToolTipService.ToolTip="Switch every source off, to pick just the ones wanted" />
            </StackPanel>
        <ItemsControl
            ItemsPanel="{StaticResource WrapPanelTemplate}"
            ItemsSource="{x:Bind ViewModel.Sources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SourceFilter">
                    <ToggleButton
                        Margin="0,0,8,8"
                        AutomationProperties.Name="{x:Bind Provider.DisplayName}"
                        IsChecked="{x:Bind IsOn, Mode=TwoWay}"
                        Style="{StaticResource ChipToggleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:IconView
                                Width="16"
                                Height="16"
                                Icon="{x:Bind Provider.Icon}" />
                            <TextBlock Text="{x:Bind Provider.DisplayName}" />
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>

        <ProgressBar
            Grid.Row="2"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />

        <StackPanel
            Grid.Row="2"
            MaxWidth="420"
            Margin="0,72,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">
            <FontIcon
                FontSize="40"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- A feed of cards, as many across as fit; their size is set in code so every picture is exactly 16:9. -->
        <ScrollViewer
            x:Name="scroller"
            Grid.Row="2"
            Margin="-8,4,-8,0"
            SizeChanged="Scroller_SizeChanged">
            <ItemsRepeater Margin="0,0,0,24" ItemsSource="{x:Bind ViewModel.Results}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="feed"
                        MinColumnSpacing="4"
                        MinItemHeight="260"
                        MinItemWidth="300"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaSearchResult">
                        <Button
                            AutomationProperties.Name="{x:Bind}"
                            Click="Result_Click"
                            Style="{StaticResource ResultButtonStyle}"
                            Tag="{x:Bind}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="84" />
                                </Grid.RowDefinitions>

                                <!--
                                    The picture, whole, over a dimmed copy of itself filling the frame: a 16:9 one covers
                                    the copy entirely, and a square cover sits in the middle with its own colours either side.
                                -->
                                <Grid Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                                    <Image Opacity="0.3" Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage DecodePixelWidth="96" UriSource="{x:Bind ThumbnailUri}" />
                                        </Image.Source>
                                    </Image>
                                    <Image Stretch="Uniform">
                                        <Image.Source>
                                            <BitmapImage DecodePixelWidth="640" UriSource="{x:Bind ThumbnailUri}" />
                                        </Image.Source>
                                    </Image>
                                    <Border
                                        Margin="8"
                                        Padding="6,2,6,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        CornerRadius="4"
                                        Opacity="0.9"
                                        Visibility="{x:Bind converters:Show.WhenSet(Duration)}">
                                        <TextBlock FontSize="12" Text="{x:Bind converters:Format.Duration(Duration)}" />
                                    </Border>
                                </Grid>

                                <!-- Its source's icon beside what it is, who made it, and how played and how old it is. -->
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconView
                                        Width="28"
                                        Height="28"
                                        Margin="2,2,0,0"
                                        VerticalAlignment="Top"
                                        Source="{x:Bind ProviderId}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Creator}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind converters:Show.WhenText(Creator)}" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind converters:Format.Meta(Views, Published)}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
