<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Search.SearchInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search"
    xmlns:media="using:MediaExport.Media.Controls"
    Height="36"
    MinWidth="280">

    <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Height="36"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The ordinary-page provider is part of the same field, but remains external to editable query text. -->
                <Button
                    x:Name="providerButton"
                    Height="34"
                    MaxWidth="180"
                    Padding="8,0"
                    AutomationProperties.Name="Search source"
                    Click="Provider_Click"
                    CornerRadius="7,0,0,7"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Choose a search source">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                        <controls:IconView
                            Width="17"
                            Height="17"
                            Icon="{Binding SelectedProvider.Icon}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding SelectedProvider.DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Border
                    x:Name="providerDivider"
                    Grid.Column="1"
                    Width="1"
                    Height="18"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ScrollViewer
                    Grid.Column="2"
                    MaxWidth="380"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <ItemsControl x:Name="termItems" ItemsSource="{Binding Draft.Terms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SearchTerm">
                                <Grid Height="34">
                                    <Button
                                        x:Name="termButton"
                                        Height="34"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind}"
                                        Click="Term_Click"
                                        PreviewKeyDown="Term_PreviewKeyDown"
                                        CornerRadius="0"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Change this search term">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontFamily="Segoe UI Symbol"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind DisplayName}" />
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ValueName, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,3,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        AutomationProperties.Name="Remove search term"
                                        Click="RemoveTerm_Click"
                                        CornerRadius="10"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Remove">
                                        <FontIcon FontSize="9" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Rectangle
                    Grid.Column="2"
                    Width="10"
                    HorizontalAlignment="Left"
                    Canvas.ZIndex="2"
                    Fill="{StaticResource LeftControlFadeBrush}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind converters:Show.WhenPositive(ViewModel.Draft.Terms.Count), Mode=OneWay}" />
                <Rectangle
                    Grid.Column="2"
                    Width="10"
                    HorizontalAlignment="Right"
                    Canvas.ZIndex="2"
                    Fill="{StaticResource RightControlFadeBrush}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind converters:Show.WhenPositive(ViewModel.Draft.Terms.Count), Mode=OneWay}" />

                <Grid Grid.Column="3">
                    <AutoSuggestBox
                        x:Name="editor"
                        Height="34"
                        MinWidth="128"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Search"
                        GotFocus="Editor_GotFocus"
                        IsSuggestionListOpen="{Binding IsSuggestionListOpen, Mode=TwoWay}"
                        ItemsSource="{Binding Suggestions}"
                        Loaded="Editor_Loaded"
                        PlaceholderText="{Binding Placeholder}"
                        PreviewKeyDown="Editor_PreviewKeyDown"
                        QuerySubmitted="Editor_QuerySubmitted"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="Editor_TextChanged"
                        TextMemberPath="Query">
                        <AutoSuggestBox.TextBoxStyle>
                            <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsSpellCheckEnabled" Value="False" />
                                <Setter Property="Padding" Value="8,0,4,0" />
                                <Setter Property="TextAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SearchSuggestion">
                                <Grid>
                                    <media:CompactMediaView Media="{x:Bind Media}" Visibility="{x:Bind converters:Show.WhenSome(Media)}" />
                                    <StackPanel
                                        Padding="0,8"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        Visibility="{x:Bind IsRecentSearch}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE81C;" />
                                        <TextBlock Text="{x:Bind Query}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Padding="0,8"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Message}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind IsMessage}" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ProgressBar
                        x:Name="busy"
                        Margin="4,0"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </Grid>

                <Button
                    Grid.Column="4"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Search"
                    Click="Search_Click"
                    CornerRadius="0,7,7,0"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Search">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                </Button>
            </Grid>
        </Border>

        <Button
            x:Name="addButton"
            Grid.Column="1"
            Width="40"
            Height="36"
            Padding="0"
            AutomationProperties.Name="Filter search"
            ToolTipService.ToolTip="Filter search">
            <FontIcon FontSize="14" Glyph="&#xE71C;" />
            <Button.Flyout>
                <MenuFlyout
                    x:Name="addMenu"
                    Closed="Menu_Closed"
                    Opening="AddMenu_Opening"
                    Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
        </Button>

        <Button
            x:Name="sortButton"
            Grid.Column="2"
            Width="40"
            Height="36"
            Padding="0"
            AutomationProperties.Name="Sort results"
            ToolTipService.ToolTip="Sort results">
            <FontIcon FontSize="14" Glyph="&#xE8CB;" />
            <Button.Flyout>
                <MenuFlyout
                    x:Name="sortMenu"
                    Closed="Menu_Closed"
                    Opening="SortMenu_Opening"
                    Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
