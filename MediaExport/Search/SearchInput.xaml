<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Search.SearchInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    Height="36"
    MinWidth="240"
    MaxWidth="840">

    <!-- A single field holding the provider button, the text box, and the clipboard and Search buttons. -->
    <Border
        x:Name="field"
        Height="36"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The provider and text box form one strip that scrolls sideways when it is longer
                than the field; the buttons after it stay in place. FieldScroll_SizeChanged keeps the strip
                at least as wide as the field, so the text box fills any spare room.
            -->
            <controls:EdgeFade Orientation="Horizontal">
                <ScrollViewer
                    x:Name="fieldScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="FieldScroll_SizeChanged"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Grid x:Name="strip">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <!-- The selected provider. Clicking it opens the list of providers. -->
                        <Button
                            x:Name="providerButton"
                            Height="34"
                            MaxWidth="180"
                            Padding="8,0"
                            AutomationProperties.Name="Search source"
                            CornerRadius="7,0,0,7"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Choose a search source"
                            Visibility="{x:Bind VisibleWith(ViewModel.SelectedProvider), Mode=OneWay}">
                            <Button.Flyout>
                                <MenuFlyout
                                    x:Name="providerMenu"
                                    Opening="ProviderMenu_Opening"
                                    Placement="BottomEdgeAlignedLeft" />
                            </Button.Flyout>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="7">
                                <controls:IconView
                                    Width="17"
                                    Height="17"
                                    Icon="{x:Bind ViewModel.SelectedProvider.Icon, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.SelectedProvider.DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Border
                            x:Name="providerDivider"
                            Grid.Column="1"
                            Style="{StaticResource FieldDividerStyle}"
                            Visibility="{x:Bind VisibleWith(ViewModel.SelectedProvider), Mode=OneWay}" />

                        <!-- The query text. Enter searches and lists the results underneath. -->
                        <AutoSuggestBox
                            x:Name="editor"
                            Grid.Column="2"
                            Height="34"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Search"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                            PlaceholderText="Search or paste a link"
                            QuerySubmitted="Editor_QuerySubmitted"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextBoxStyle="{StaticResource SearchTextBoxStyle}"
                            TextMemberPath="Title">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaSearchResult">
                                    <StackPanel Padding="0,6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Creator}"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <ProgressBar
                            x:Name="busy"
                            Grid.Column="2"
                            Margin="4,0"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, FallbackValue=Collapsed}" />
                    </Grid>
                </ScrollViewer>
            </controls:EdgeFade>

            <Button
                x:Name="queryActionsButton"
                Grid.Column="1"
                AutomationProperties.Name="Clipboard actions"
                Style="{StaticResource RowActionButtonStyle}"
                ToolTipService.ToolTip="Copy to clipboard, paste from clipboard, or clear">
                <FontIcon FontSize="14" Glyph="&#xE77F;" />
                <Button.Flyout>
                    <MenuFlyout Opening="QueryActionsMenu_Opening" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem
                            x:Name="copyQueryItem"
                            Click="CopyQuery_Click"
                            Text="Copy to clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="pasteQueryItem"
                            Click="PasteQuery_Click"
                            Text="Paste from clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="clearQueryItem"
                            Click="ClearQuery_Click"
                            Text="Clear query">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Runs the search and opens the Search page with the results. -->
            <Button
                x:Name="searchButton"
                Grid.Column="2"
                AutomationProperties.Name="Search"
                Click="Search_Click"
                CornerRadius="0,7,7,0"
                Style="{StaticResource RowActionButtonStyle}"
                ToolTipService.ToolTip="Search">
                <Viewbox Width="15" Height="15">
                    <SymbolIcon Symbol="Find" />
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>
