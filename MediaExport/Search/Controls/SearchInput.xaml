<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Search.Controls.SearchInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search.Controls"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    xmlns:providers="using:MediaExport.Core.Media.Providers"
    Height="36"
    MinWidth="240"
    MaxWidth="840">

    <!-- A single field holding the provider button, the query box, and the clipboard and Search buttons. -->
    <Border
        x:Name="field"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <!-- The field looks like a focused text box while the query box has focus. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="field.Background" Value="{ThemeResource TextControlBackgroundFocused}" />
                        <Setter Target="focusBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                The provider button, the terms and the query box scroll sideways together when they are longer
                than the field. The buttons after them stay in place.
            -->
            <controls:EdgeFade Orientation="Horizontal">
                <ScrollViewer
                    x:Name="fieldScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="FieldScroll_SizeChanged"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Grid x:Name="fieldContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <Button
                            MaxWidth="180"
                            AutomationProperties.Name="Search source"
                            Style="{StaticResource FieldButtonStyle}"
                            ToolTipService.ToolTip="Choose a search source"
                            Visibility="{x:Bind converters:VisibleWhen.NotNull(ViewModel.SelectedProvider), Mode=OneWay, FallbackValue=Collapsed}">
                            <Button.Flyout>
                                <MenuFlyout
                                    x:Name="providerMenu"
                                    Opening="ProviderMenu_Opening"
                                    Placement="BottomEdgeAlignedLeft" />
                            </Button.Flyout>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="7">
                                <controls:IconView
                                    Width="17"
                                    Height="17"
                                    Icon="{x:Bind ViewModel.SelectedProvider.Icon, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.SelectedProvider.DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Border
                            Grid.Column="1"
                            Style="{StaticResource FieldDividerStyle}"
                            Visibility="{x:Bind converters:VisibleWhen.NotNull(ViewModel.SelectedProvider), Mode=OneWay, FallbackValue=Collapsed}" />

                        <!--
                            The terms that narrow the search. A term comes from the menu beside the clipboard
                            button, or from label:value typed or pasted into the query box.
                        -->
                        <ItemsRepeater
                            x:Name="termsRepeater"
                            Grid.Column="2"
                            ElementPrepared="TermsRepeater_ElementPrepared"
                            ItemsSource="{x:Bind ViewModel.Terms, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="providers:SearchTerm">
                                    <local:SearchTermBox
                                        Edited="TermBox_Edited"
                                        EditingEnded="TermBox_EditingEnded"
                                        Removed="TermBox_Removed"
                                        Term="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBox
                            x:Name="queryBox"
                            Grid.Column="3"
                            AutomationProperties.Name="Search"
                            GotFocus="QueryBox_FocusChanged"
                            KeyDown="QueryBox_KeyDown"
                            PreviewKeyDown="QueryBox_PreviewKeyDown"
                            LostFocus="QueryBox_FocusChanged"
                            Paste="QueryBox_Paste"
                            PlaceholderText="Search or paste a link"
                            Style="{StaticResource SearchTextBoxStyle}"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="QueryBox_TextChanged"
                            TextChanging="QueryBox_TextChanging">
                            <!--
                                The field draws the background and border, so the box's own are turned off,
                                including the ones it shows when focused or hovered.
                            -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

                                <!-- The box's delete button, made to match FieldIconButtonStyle. -->
                                <Thickness x:Key="TextBoxInnerButtonMargin">4,2,0,2</Thickness>
                                <x:Double x:Key="TextBoxIconFontSize">14</x:Double>
                                <StaticResource x:Key="TextControlButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </ScrollViewer>
            </controls:EdgeFade>

            <!--
                The focused text box's accent underline, drawn over the field's border. Thickening the
                border itself would move everything inside the field.
            -->
            <Border
                x:Name="focusBorder"
                Grid.ColumnSpan="4"
                Margin="-1"
                BorderBrush="{ThemeResource TextControlBorderBrushFocused}"
                BorderThickness="{ThemeResource TextControlBorderThemeThicknessFocused}"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <ProgressBar
                Grid.ColumnSpan="4"
                Margin="0,0"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, FallbackValue=Collapsed}" />

            <!--
                The results are in a popup so that they lie over the page instead of taking room in the
                title bar.
            -->
            <Popup
                x:Name="resultsPopup"
                Grid.ColumnSpan="4"
                HorizontalOffset="-1">
                <!--
                    The panel slides down from above its place as it opens, the way a menu does. The grid
                    cuts off whatever is above the popup's top edge, so the panel comes out from under the
                    field instead of passing over it.
                -->
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,4000,4000" />
                    </Grid.Clip>
                    <Border
                        x:Name="resultsPanel"
                        MaxHeight="440"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Transitions>
                            <TransitionCollection>
                                <EdgeUIThemeTransition Edge="Top" />
                            </TransitionCollection>
                        </Border.Transitions>
                        <controls:EdgeFade>
                            <!-- The padding keeps the rows, and their highlight, clear of the scroll bar. -->
                            <ListView
                                x:Name="resultsList"
                                Padding="0,0,8,0"
                                IsItemClickEnabled="True"
                                ItemClick="ResultsList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.FirstPageResults, Mode=OneWay}"
                                LostFocus="QueryBox_FocusChanged"
                                PreviewKeyDown="ResultsList_PreviewKeyDown"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaSearchResult">
                                        <media:RowMediaView Media="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </controls:EdgeFade>
                    </Border>
                </Grid>
            </Popup>

            <!-- Lists the kinds of term. Choosing one adds it to the field with its value ready to type. -->
            <Button
                Grid.Column="1"
                Margin="2,2,0,2"
                AutomationProperties.Name="Add a search term"
                Style="{StaticResource FieldIconButtonStyle}"
                ToolTipService.ToolTip="Add a search term">
                <FontIcon Glyph="&#xE71C;" Style="{StaticResource FieldIconStyle}" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Click="AddTerm_Click" Tag="exact" Text="Exact">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE718;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="AddTerm_Click" Tag="exclude" Text="Exclude">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE733;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="AddTerm_Click" Tag="author" Text="Author">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!--
                Copies the search, or pastes one when the box is empty. Right-clicking offers both.
            -->
            <Button
                x:Name="clipboardButton"
                Grid.Column="2"
                Margin="2,2,0,2"
                controls:VisibilityTransition.Fade="True"
                Click="ClipboardButton_Click"
                Style="{StaticResource FieldIconButtonStyle}"
                Visibility="Collapsed">
                <!-- The two icons overlap. UpdateClipboardButton shows one and cross-fades between them. -->
                <Grid>
                    <FontIcon
                        x:Name="copyIcon"
                        Glyph="&#xE8C8;"
                        Style="{StaticResource FieldIconStyle}" />
                    <FontIcon
                        x:Name="pasteIcon"
                        Glyph="&#xE77F;"
                        Style="{StaticResource FieldIconStyle}" />
                </Grid>
                <Button.ContextFlyout>
                    <MenuFlyout Opening="ClipboardMenu_Opening" Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem
                            x:Name="copyQueryItem"
                            Click="CopyQuery_Click"
                            Text="Copy to clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="pasteQueryItem"
                            Click="PasteQuery_Click"
                            Text="Paste from clipboard">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>

            <Button
                Grid.Column="3"
                AutomationProperties.Name="Search"
                Click="Search_Click"
                Style="{StaticResource FieldIconButtonStyle}"
                ToolTipService.ToolTip="Search">
                <FontIcon Glyph="&#xE721;" Style="{StaticResource FieldIconStyle}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
