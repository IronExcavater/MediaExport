<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Search.Controls.SearchInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Search.Controls"
    xmlns:search="using:MediaExport.Search"
    xmlns:media="using:MediaExport.Media.Controls"
    xmlns:models="using:MediaExport.Core.Media.Models"
    xmlns:providers="using:MediaExport.Core.Media.Providers"
    Height="36"
    MinWidth="240"
    MaxWidth="840">

    <Border
        x:Name="field"
        Background="{ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <!-- Looks like a focused text box while the query box has focus. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="field.Background" Value="{ThemeResource TextControlBackgroundFocused}" />
                        <Setter Target="focusBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Everything before the buttons scrolls sideways together when it is longer than the field. -->
            <controls:EdgeFade Orientation="Horizontal">
                <ScrollViewer
                    x:Name="fieldScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    SizeChanged="FieldScroll_SizeChanged"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Grid
                        x:Name="fieldContent"
                        Padding="2,2,0,2"
                        ColumnSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <!-- The chosen providers as overlapping icons. Their names are in the flyout. -->
                        <Button
                            x:Name="providerButton"
                            AutomationProperties.Name="Search sources"
                            Style="{StaticResource FieldButtonStyle}">
                            <Button.Flyout>
                                <Flyout
                                    x:Name="providerFlyout"
                                    Closed="ProviderFlyout_Closed"
                                    Opened="ProviderFlyout_Opened"
                                    Opening="ProviderFlyout_Opening"
                                    Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0,2" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <local:ProviderPicker
                                        x:Name="providerPicker"
                                        OneChosen="ProviderPicker_OneChosen"
                                        ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                                </Flyout>
                            </Button.Flyout>
                            <controls:IconStack x:Name="providerIcons" VerticalAlignment="Center" />
                        </Button>
                        <Border
                            x:Name="providerDivider"
                            Grid.Column="1"
                            Style="{StaticResource FieldDividerStyle}" />

                        <!-- Terms come from the add-term menu, or from label:value typed into the query box. -->
                        <ItemsRepeater
                            x:Name="termsRepeater"
                            Grid.Column="2"
                            ElementPrepared="TermsRepeater_ElementPrepared"
                            KeyDown="TermsRepeater_KeyDown"
                            ItemsSource="{x:Bind ViewModel.Terms, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="providers:SearchTerm">
                                    <local:SearchTermBox
                                        Edited="TermBox_Edited"
                                        Removed="TermBox_Removed"
                                        Term="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- The margin undoes the field's inset, so the box is the field's height and its text sits mid-field. -->
                        <TextBox
                            x:Name="queryBox"
                            Grid.Column="3"
                            Margin="0,-2"
                            AutomationProperties.Name="Search"
                            GotFocus="QueryBox_FocusChanged"
                            KeyDown="QueryBox_KeyDown"
                            PreviewKeyDown="QueryBox_PreviewKeyDown"
                            LostFocus="QueryBox_FocusChanged"
                            Paste="QueryBox_Paste"
                            PlaceholderText="Search or paste a link"
                            Style="{StaticResource SearchTextBoxStyle}"
                            Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="QueryBox_TextChanged"
                            TextChanging="QueryBox_TextChanging">
                            <!-- The field draws the background and border, so the box's own are turned off. -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </ScrollViewer>
            </controls:EdgeFade>

            <!-- The focus underline, drawn over the border so that nothing inside the field moves. -->
            <Border
                x:Name="focusBorder"
                Grid.ColumnSpan="2"
                Margin="-1"
                BorderBrush="{ThemeResource TextControlBorderBrushFocused}"
                BorderThickness="{ThemeResource TextControlBorderThemeThicknessFocused}"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <ProgressBar
                Grid.ColumnSpan="2"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, FallbackValue=Collapsed}" />

            <!-- A popup, so the results lie over the page instead of taking room in the title bar. -->
            <Popup
                x:Name="resultsPopup"
                Closed="ResultsPopup_OpenChanged"
                Opened="ResultsPopup_OpenChanged"
                Grid.ColumnSpan="2"
                HorizontalOffset="-1">
                <!-- The panel slides down like a menu, clipped by the grid so it comes out from under the field. -->
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,4000,4000" />
                    </Grid.Clip>
                    <Border
                        x:Name="resultsPanel"
                        MaxHeight="440"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Transitions>
                            <TransitionCollection>
                                <EdgeUIThemeTransition Edge="Top" />
                            </TransitionCollection>
                        </Border.Transitions>
                        <Grid>
                        <!-- Something that went wrong, such as a link that couldn't be opened. -->
                        <Grid
                            x:Name="messageRow"
                            Padding="16,10"
                            ColumnSpacing="10"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE783;" />
                            <TextBlock
                                x:Name="messageText"
                                Grid.Column="1"
                                TextWrapping="Wrap" />
                        </Grid>

                        <!-- Recent searches, offered while the field is empty. Each reads as it would in the field. -->
                        <ListView
                            x:Name="recentsList"
                            AutomationProperties.Name="Recently searched"
                            Padding="0,4"
                            controls:ScrollBarGutter.Mode="Auto"
                            IsItemClickEnabled="True"
                            ItemClick="RecentsList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.RecentSearches, Mode=OneWay}"
                            LostFocus="QueryBox_FocusChanged"
                            PreviewKeyDown="ResultsList_PreviewKeyDown"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="search:RecentSearch">
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The top margin lowers the icons a pixel, onto the middle of the text beside them. -->
                                        <controls:IconStack
                                            Margin="0,1,6,0"
                                            VerticalAlignment="Center"
                                            Icons="{x:Bind ProviderIcons}" />

                                        <!-- The terms are only shown here, so they take no presses and no focus. -->
                                        <ItemsRepeater
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            ItemsSource="{x:Bind Terms}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="providers:SearchTerm">
                                                    <local:SearchTermBox IsEnabled="False" Term="{x:Bind}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="6,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Words}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!-- A pinned search stays at the top of the list. -->
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="{x:Bind local:SearchInput.PinAction(IsPinned)}"
                                            Click="PinRecent_Click"
                                            Style="{StaticResource RowIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind local:SearchInput.PinAction(IsPinned)}">
                                            <FontIcon FontSize="12" Glyph="{x:Bind local:SearchInput.PinGlyph(IsPinned)}" />
                                        </Button>
                                        <Button
                                            Grid.Column="4"
                                            AutomationProperties.Name="Remove"
                                            Click="RemoveRecent_Click"
                                            Style="{StaticResource RowIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Remove">
                                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Skeleton rows while the first page loads. -->
                        <StackPanel
                            x:Name="resultsSkeleton"
                            Padding="16,2"
                            Visibility="Collapsed">
                            <media:RowMediaView />
                            <media:RowMediaView />
                            <media:RowMediaView />
                            <media:RowMediaView />
                        </StackPanel>
                        <controls:EdgeFade x:Name="resultsFade">
                            <ListView
                                x:Name="resultsList"
                                controls:ScrollBarGutter.Mode="Auto"
                                IsItemClickEnabled="True"
                                ItemClick="ResultsList_ItemClick"
                                ItemsSource="{x:Bind ViewModel.FirstPageResults, Mode=OneWay}"
                                LostFocus="QueryBox_FocusChanged"
                                PreviewKeyDown="ResultsList_PreviewKeyDown"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaSearchResult">
                                        <media:RowMediaView Media="{x:Bind}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </controls:EdgeFade>
                        </Grid>
                    </Border>
                </Grid>
            </Popup>

            <StackPanel
                Grid.Column="1"
                Margin="2"
                Orientation="Horizontal"
                Spacing="2">
                <!-- Empties the query box and every term, in place of the query box's own hidden delete button. -->
                <Button
                    x:Name="deleteButton"
                    controls:VisibilityTransition.Fade="True"
                    AutomationProperties.Name="Clear"
                    Click="DeleteButton_Click"
                    Style="{StaticResource FieldIconButtonStyle}"
                    ToolTipService.ToolTip="Clear"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE711;" Style="{StaticResource FieldIconStyle}" />
                </Button>

                <Button
                    x:Name="sortButton"
                    AutomationProperties.Name="Sort results"
                    Style="{StaticResource FieldIconButtonStyle}"
                    ToolTipService.ToolTip="Sort results">
                    <FontIcon Glyph="&#xE8CB;" Style="{StaticResource FieldIconStyle}" />
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="sortMenu"
                            Opening="SortMenu_Opening"
                            Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>

                <!-- Adds a term that narrows the results, with its value ready to type. -->
                <Button
                    AutomationProperties.Name="Filter results"
                    Style="{StaticResource FieldIconButtonStyle}"
                    ToolTipService.ToolTip="Filter results">
                    <FontIcon Glyph="&#xE71C;" Style="{StaticResource FieldIconStyle}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="AddTerm_Click" Tag="exact" Text="Exact">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="AddTerm_Click" Tag="exclude" Text="Exclude">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE733;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="AddTerm_Click" Tag="author" Text="Author">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="AddTerm_Click" Tag="duration" Text="Duration">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE916;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="AddTerm_Click" Tag="published" Text="Published">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE787;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Copies the whole search, or pastes one when there is nothing to copy. -->
                <controls:ClipboardButton
                    x:Name="clipboardButton"
                    controls:VisibilityTransition.Fade="True"
                    Pasted="ClipboardButton_Pasted"
                    Text="{x:Bind ViewModel.FullText, Mode=OneWay}" />

                <!-- Opens the Search page, and reads "See all results" while results are listed under the field. -->
                <Button
                    x:Name="searchButton"
                    AutomationProperties.Name="Search"
                    Click="Search_Click"
                    Style="{StaticResource FieldIconButtonStyle}"
                    ToolTipService.ToolTip="Search">
                    <!-- Two overlapping icons that cross-fade. -->
                    <Grid>
                        <FontIcon
                            x:Name="searchIcon"
                            Glyph="&#xE721;"
                            Style="{StaticResource FieldIconStyle}" />
                        <FontIcon
                            x:Name="seeAllIcon"
                            Glyph="&#xE8A7;"
                            Opacity="0"
                            Style="{StaticResource FieldIconStyle}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
