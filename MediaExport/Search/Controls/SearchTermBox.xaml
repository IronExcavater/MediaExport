<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaExport.Search.Controls.SearchTermBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Slides the term in and out by its width, set in code, so what follows it in the field moves along. -->
        <Storyboard x:Name="slide" Completed="Slide_Completed">
            <DoubleAnimation
                x:Name="slideWidth"
                EnableDependentAnimation="True"
                Storyboard.TargetProperty="MaxWidth"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- A value box draws nothing of its own. AcceptsReturn is on only to remove TextBox's own delete button. -->
        <Style x:Key="TermValueBoxStyle" BasedOn="{StaticResource SearchTextBoxStyle}" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MaxWidth" Value="160" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The pickers under a range's box. They don't take the keyboard, so typing carries on with one open. -->
        <Style x:Key="PickerPresenterStyle" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <!-- Steps a duration without taking the keyboard from the box. -->
        <Style x:Key="StepButtonStyle" BasedOn="{StaticResource DefaultRepeatButtonStyle}" TargetType="RepeatButton">
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="26" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
        </Style>

        <!-- Each button's Tag is the minutes it adds. -->
        <Flyout
            x:Name="durationPicker"
            Closed="Picker_Closed"
            FlyoutPresenterStyle="{StaticResource PickerPresenterStyle}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RepeatButton
                        AutomationProperties.Name="One hour less"
                        Click="DurationStep_Click"
                        Style="{StaticResource StepButtonStyle}"
                        Tag="-60">
                        <FontIcon FontSize="10" Glyph="&#xE738;" />
                    </RepeatButton>
                    <TextBlock
                        x:Name="hoursText"
                        MinWidth="30"
                        VerticalAlignment="Center"
                        TextAlignment="Center" />
                    <RepeatButton
                        AutomationProperties.Name="One hour more"
                        Click="DurationStep_Click"
                        Style="{StaticResource StepButtonStyle}"
                        Tag="60">
                        <FontIcon FontSize="10" Glyph="&#xE710;" />
                    </RepeatButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RepeatButton
                        AutomationProperties.Name="Five minutes less"
                        Click="DurationStep_Click"
                        Style="{StaticResource StepButtonStyle}"
                        Tag="-5">
                        <FontIcon FontSize="10" Glyph="&#xE738;" />
                    </RepeatButton>
                    <TextBlock
                        x:Name="minutesText"
                        MinWidth="34"
                        VerticalAlignment="Center"
                        TextAlignment="Center" />
                    <RepeatButton
                        AutomationProperties.Name="Five minutes more"
                        Click="DurationStep_Click"
                        Style="{StaticResource StepButtonStyle}"
                        Tag="5">
                        <FontIcon FontSize="10" Glyph="&#xE710;" />
                    </RepeatButton>
                </StackPanel>
            </StackPanel>
        </Flyout>

        <Flyout
            x:Name="datePicker"
            Closed="Picker_Closed"
            FlyoutPresenterStyle="{StaticResource PickerPresenterStyle}">
            <CalendarView x:Name="calendar" SelectedDatesChanged="Calendar_SelectedDatesChanged" />
        </Flyout>
    </UserControl.Resources>

    <Grid x:Name="content">
        <!-- While edited, the term looks like a focused text box and its remove slot widens. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Resting">
                    <Storyboard>
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            Storyboard.TargetName="removeSlot"
                            Storyboard.TargetProperty="Width"
                            To="0"
                            Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Editing">
                    <VisualState.Setters>
                        <Setter Target="editingBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            Storyboard.TargetName="removeSlot"
                            Storyboard.TargetProperty="Width"
                            To="22"
                            Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The resting look, and the term when it is selected. A press edits it without the button taking focus. -->
        <Button
            x:Name="restingButton"
            HorizontalAlignment="Stretch"
            AllowFocusOnInteraction="False"
            Click="RestingButton_Click"
            Style="{StaticResource FieldButtonStyle}" />

        <Border
            x:Name="editingBorder"
            Background="{ThemeResource TextControlBackgroundFocused}"
            BorderBrush="{ThemeResource TextControlBorderBrushFocused}"
            BorderThickness="{ThemeResource TextControlBorderThemeThicknessFocused}"
            CornerRadius="6"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!-- The spacing before the empty remove slot is the term's right padding. -->
        <StackPanel
            Margin="6,0,0,0"
            Orientation="Horizontal"
            Spacing="6">
            <StackPanel.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
            </StackPanel.Resources>

            <!-- The top margin lowers the icon a pixel, onto the middle of the text beside it. -->
            <FontIcon
                x:Name="labelIcon"
                Margin="0,2,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsHitTestVisible="False" />

            <!-- The value at rest. A range reads as "3m – 10m", or "> 3m" with one end. -->
            <TextBlock
                x:Name="valueText"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />

            <!-- A word term's value while edited, or a range's first end. -->
            <TextBox
                x:Name="valueBox"
                GotFocus="ValueBox_GotFocus"
                LostFocus="ValueBox_LostFocus"
                Tapped="ValueBox_Tapped"
                TextChanged="ValueBox_TextChanged"
                PreviewKeyDown="ValueBox_PreviewKeyDown"
                Style="{StaticResource TermValueBoxStyle}"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="rangeDash"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="&#x2013;"
                Visibility="Collapsed" />

            <!-- A range's second end while edited. -->
            <TextBox
                x:Name="upperBox"
                GotFocus="ValueBox_GotFocus"
                LostFocus="ValueBox_LostFocus"
                Tapped="ValueBox_Tapped"
                TextChanged="ValueBox_TextChanged"
                PreviewKeyDown="ValueBox_PreviewKeyDown"
                Style="{StaticResource TermValueBoxStyle}"
                Visibility="Collapsed" />

            <!-- The slot widens only while the term is edited. Taking focus would end the editing. -->
            <Grid x:Name="removeSlot" Width="0">
                <Button
                    Width="20"
                    Margin="0,1,2,1"
                    HorizontalAlignment="Left"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Remove"
                    Click="RemoveButton_Click"
                    IsTabStop="False"
                    Style="{StaticResource FieldIconButtonStyle}"
                    ToolTipService.ToolTip="Remove">
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
