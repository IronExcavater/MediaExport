<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SettingsHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>
        <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Padding="24,0,24,32"
            Spacing="4">

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Appearance" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Theme" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <RadioButton
                            Content="Light"
                            GroupName="theme"
                            IsChecked="{x:Bind ViewModel.IsLightTheme, Mode=TwoWay}"
                            Style="{StaticResource ChipRadioButtonStyle}" />
                        <RadioButton
                            Content="Dark"
                            GroupName="theme"
                            IsChecked="{x:Bind ViewModel.IsDarkTheme, Mode=TwoWay}"
                            Style="{StaticResource ChipRadioButtonStyle}" />
                        <RadioButton
                            Content="Same as Windows"
                            GroupName="theme"
                            IsChecked="{x:Bind ViewModel.IsSystemTheme, Mode=TwoWay}"
                            Style="{StaticResource ChipRadioButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Tools" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolViewModel">
                        <Grid Margin="0,0,0,4">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20">
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xEC61;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xEA39;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind HasError, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{x:Bind Name}" />
                                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Purpose}" />
                                        </TextBlock>
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind Summary, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind Status.Path, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Command="{x:Bind InstallCommand}"
                                            Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{x:Bind HasPrimaryAction, Mode=OneWay}" />
                                        <DropDownButton
                                            Content="Version"
                                            IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                            ToolTipService.ToolTip="Install a particular version">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Opening="Versions_Opening" Placement="BottomEdgeAlignedRight" />
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <Button
                                            AutomationProperties.Name="Remove"
                                            Command="{x:Bind RemoveCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Remove MediaExport's copy"
                                            Visibility="{x:Bind IsManaged, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Over the card's bottom edge while installing, so the card doesn't change size. -->
                            <ProgressBar
                                Margin="8,0,8,1"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="{x:Bind converters:Show.Not(IsProgressKnown), Mode=OneWay}"
                                Visibility="{x:Bind IsWorking, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Signing in" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Use a browser's sign-in" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="For media that needs an account, like age-restricted or members-only videos. Pick a browser you're signed in with." />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Browser to sign in with"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Browsers}"
                        SelectedItem="{x:Bind ViewModel.SelectedBrowser, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="History" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Recent picks" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Shown on the home page and when you start a search" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearSearchHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasSearchHistory, Mode=OneWay}" />
                    </Grid>
                    <Rectangle Style="{StaticResource DividerStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Finished exports" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Listed in Activity. Clearing the list leaves the files alone." />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearExportHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasExportHistory, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="About" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="56"
                            Height="56"
                            Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="MediaExport" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                <Run Text="Version" />
                                <Run Text="{x:Bind ViewModel.Version}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <TextBlock TextWrapping="Wrap">
                        Save video and audio from YouTube, SoundCloud and hundreds of other sites, whole or in clips. Please only export what you have the right to keep.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Source code" NavigateUri="https://github.com/IronExcavater/MediaExport" />
                        <HyperlinkButton Content="Report a problem" NavigateUri="https://github.com/IronExcavater/MediaExport/issues/new" />
                        <HyperlinkButton Content="Licence (MPL 2.0)" NavigateUri="https://github.com/IronExcavater/MediaExport/blob/main/LICENSE" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource DividerStyle}" />
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Made by Niclas Rogulski, Andrew Shillabeer and Ezekiel Paterno." />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="Built on" />
                            <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp">yt-dlp</Hyperlink><Run Text="," />
                            <Hyperlink NavigateUri="https://ffmpeg.org">FFmpeg</Hyperlink>
                            <Run Text="and" />
                            <Hyperlink NavigateUri="https://deno.com">Deno</Hyperlink><Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
