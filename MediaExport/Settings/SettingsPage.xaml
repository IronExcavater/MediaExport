<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SettingsHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>
        <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsComboBoxStyle" BasedOn="{StaticResource RoundedComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="BrowserChoiceTemplate" x:DataType="local:BrowserChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:IconView
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Icon="{x:Bind Icon}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ThemeChoiceTemplate" x:DataType="local:SettingsChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    Width="18"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="{x:Bind Glyph}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>
        <converters:PassThroughConverter x:Key="PassThrough" />
    </Page.Resources>

    <Grid>
    <ScrollViewer
        x:Name="settingsScroller"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            Width="{Binding ViewportWidth, ElementName=settingsScroller, Mode=OneWay}"
            MaxWidth="1000"
            Padding="24,0,24,32"
            HorizontalAlignment="Center">
        <StackPanel Spacing="4">

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Appearance" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Theme" />
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="Theme"
                        ItemTemplate="{StaticResource ThemeChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Themes}"
                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                        Style="{StaticResource SettingsComboBoxStyle}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Tools" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolViewModel">
                        <Grid Margin="0,0,0,4">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsActive="{x:Bind IsChecking, Mode=OneWay}"
                                            Visibility="{x:Bind IsChecking, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xEC61;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xEA39;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind HasError, Mode=OneWay}" />
                                    </Grid>

                                    <!-- Name and version first; where it came from, or what went wrong, underneath. -->
                                    <StackPanel Grid.Column="1" MinHeight="38" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                VerticalAlignment="Bottom"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind VersionText, Mode=OneWay}"
                                                Visibility="{x:Bind converters:Show.Unless(IsChecking), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind SourceText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind SourceText, Mode=OneWay}"
                                            Visibility="{x:Bind converters:Show.Unless(IsChecking), Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Margin="0,0,4,0"
                                            Command="{x:Bind InstallCommand}"
                                            Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                            Style="{StaticResource InlineActionButtonStyle}"
                                            Visibility="{x:Bind HasPrimaryAction, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.Name="Website"
                                            Click="Link_Click"
                                            Style="{StaticResource InlineIconButtonStyle}"
                                            Tag="{x:Bind Website}"
                                            ToolTipService.ToolTip="Website"
                                            Visibility="{x:Bind HasWebsite}">
                                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Source code"
                                            Click="Link_Click"
                                            Style="{StaticResource InlineIconButtonStyle}"
                                            Tag="{x:Bind SourceCode}"
                                            ToolTipService.ToolTip="Source code">
                                            <FontIcon FontSize="16" Glyph="&#xE943;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Remove"
                                            Command="{x:Bind RemoveCommand}"
                                            Style="{StaticResource InlineIconButtonStyle}"
                                            ToolTipService.ToolTip="Remove the copy MediaExport installed"
                                            Visibility="{x:Bind CanRemove, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Over the card's bottom edge while installing, so the card doesn't change size. -->
                            <ProgressBar
                                Margin="8,0,8,1"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="{x:Bind converters:Show.Not(IsProgressKnown), Mode=OneWay}"
                                Visibility="{x:Bind IsWorking, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Signing in" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sign in with a browser" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="For videos that need an account, such as age-restricted ones" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="Browser to sign in with"
                        ItemTemplate="{StaticResource BrowserChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.Browsers}"
                        SelectedItem="{x:Bind ViewModel.SelectedBrowser, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                        Style="{StaticResource SettingsComboBoxStyle}" />
                </Grid>
            </Border>

            <!-- What the app remembers, how much of each, and a way to forget each or all of it. -->
            <Grid>
                <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="History" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Command="{x:Bind ViewModel.ClearAllHistoryCommand}"
                    IsEnabled="{x:Bind ViewModel.HasAnyHistory, Mode=OneWay}"
                    ToolTipService.ToolTip="Clear the searches, the opened media and the finished exports together">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Clear all" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Recent searches" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RecentSearchesText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearRecentSearchesCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasRecentSearches, Mode=OneWay}" />
                    </Grid>
                    <Rectangle Style="{StaticResource DividerStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B2;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Recently opened media" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RecentMediaText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearRecentMediaCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasRecentMedia, Mode=OneWay}" />
                    </Grid>
                    <Rectangle Style="{StaticResource DividerStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Finished exports" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ExportHistoryText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearExportHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasExportHistory, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="About" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="48"
                        Height="48"
                        Source="ms-appx:///Assets/App/Square44x44Logo.scale-200.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="MediaExport" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Version}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="By Niclas Rogulski, Andrew Shillabeer and Ezekiel Paterno" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            AutomationProperties.Name="Source code"
                            Click="Link_Click"
                            Style="{StaticResource InlineIconButtonStyle}"
                            Tag="https://github.com/IronExcavater/MediaExport"
                            ToolTipService.ToolTip="Source code">
                            <FontIcon FontSize="16" Glyph="&#xE943;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Report a problem"
                            Click="Link_Click"
                            Style="{StaticResource InlineIconButtonStyle}"
                            Tag="https://github.com/IronExcavater/MediaExport/issues/new"
                            ToolTipService.ToolTip="Report a problem">
                            <FontIcon FontSize="16" Glyph="&#xEBE8;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Licence"
                            Click="Link_Click"
                            Style="{StaticResource InlineIconButtonStyle}"
                            Tag="https://github.com/IronExcavater/MediaExport/blob/main/LICENSE"
                            ToolTipService.ToolTip="Licence">
                            <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
        <Rectangle
            Height="14"
            VerticalAlignment="Top"
            Canvas.ZIndex="2"
            Fill="{StaticResource TopPageFadeBrush}"
            IsHitTestVisible="False" />
        <Rectangle
            Height="14"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="2"
            Fill="{StaticResource BottomPageFadeBrush}"
            IsHitTestVisible="False" />
    </Grid>
</Page>
