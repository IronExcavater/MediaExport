<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:settings="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- A small button beside a group's heading, for something done to the whole group. -->
        <Style x:Key="GroupActionStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Page.Resources>

    <!--
        The settings scroll when the window is too short for them. The page's width is capped out here, not on the
        panel in the scroller: a ScrollViewer centres content narrower than itself by the width the content asks
        for, not the width it is given, which put the settings off to one side on a wide window.
    -->
    <Grid MaxWidth="{StaticResource PageMaxWidth}">
        <controls:EdgeFade>
            <ScrollViewer controls:ScrollBarGutter.Mode="Auto">
                <!--
                    Each group is one panel under its heading, and each setting a row in it: an icon, a name with a line
                    saying what it is for, and its control at the end. A row draws the line above it, so the first row
                    of a panel has its border taken off.
                -->
                <StackPanel Padding="{StaticResource PagePadding}">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Appearance" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Light, dark, or whichever Windows is using" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Theme"
                                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ThemeOption">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                                                <TextBlock Text="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- What is done to all the tools is beside their heading, and what is done to one is in its row. -->
                    <Grid>
                        <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Tools" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Command="{x:Bind ViewModel.RefreshToolsCommand}"
                                Style="{StaticResource GroupActionStyle}"
                                ToolTipService.ToolTip="Look for each tool again">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Check again" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.OpenToolsFolderCommand}"
                                Style="{StaticResource GroupActionStyle}"
                                ToolTipService.ToolTip="Open the folder MediaExport installs tools into">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE838;" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Open folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Auto update" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Keep the tools MediaExport installed up to date" />
                                </StackPanel>
                                <!-- The switch's own On and Off labels are dropped, and with them the room it keeps for them. -->
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    AutomationProperties.Name="Auto update"
                                    IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </Border>
                    </Border>

                    <!--
                        The tools the app runs: whether each is installed, its version, and where it was found. The rows
                        bring their own padding, so the expander's is taken off, and the first row's line is tucked under
                        the one the expander draws below its header.
                    -->
                    <Expander
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        CornerRadius="8"
                        IsExpanded="True">
                        <Expander.Header>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE74C;" Style="{StaticResource SettingsIconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Installed tools" />
                                <Button
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.UpdateAllCommand}"
                                    Content="Update all" />
                            </Grid>
                        </Expander.Header>

                        <ItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind ViewModel.Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:ToolViewModel">
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- One of these shows: looking for it, installed, missing, or something went wrong. -->
                                            <Grid Width="20">
                                                <ProgressRing
                                                    Width="16"
                                                    Height="16"
                                                    IsActive="{x:Bind IsChecking, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Glyph="&#xEC61;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Glyph="&#xE7BA;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Glyph="&#xEA39;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind HasError, Mode=OneWay}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VersionText, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind SourceText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    ToolTipService.ToolTip="{x:Bind SourceText, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- The one thing most worth doing is a button. The rest is in the menu beside it. -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    Command="{x:Bind InstallCommand}"
                                                    Content="Install"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{x:Bind CanInstall, Mode=OneWay}" />
                                                <Button
                                                    AutomationProperties.Name="More"
                                                    Style="{StaticResource RowIconButtonStyle}"
                                                    ToolTipService.ToolTip="More">
                                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem Command="{x:Bind OpenWebsiteCommand}" Text="Website">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE774;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Command="{x:Bind OpenSourceCodeCommand}" Text="Source code">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE943;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Command="{x:Bind ShowInFolderCommand}" Text="Show in folder">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE838;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <!-- Only a copy the app installed is its to delete, so this is off for any other. -->
                                                            <MenuFlyoutItem Command="{x:Bind RemoveCommand}" Text="Remove">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- What the app remembers, each with how much there is, so it is clear what clearing clears. -->
                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="History" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel>
                            <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE721;" Style="{StaticResource SettingsIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Recent searches" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RecentSearchesText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Clear recent searches"
                                        Command="{x:Bind ViewModel.ClearRecentSearchesCommand}"
                                        Content="Clear" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE7B3;" Style="{StaticResource SettingsIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Recently viewed" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.RecentlyViewedText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Clear recently viewed"
                                        Command="{x:Bind ViewModel.ClearRecentlyViewedCommand}"
                                        Content="Clear" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Export history" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ExportHistoryText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Clear export history"
                                        Command="{x:Bind ViewModel.ClearExportHistoryCommand}"
                                        Content="Clear" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="About" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Width="20"
                                    Height="20"
                                    Source="{StaticResource AppLogo}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MediaExport" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.VersionText}" />
                                </StackPanel>
                                <HyperlinkButton
                                    Grid.Column="2"
                                    Content="Source code"
                                    NavigateUri="https://github.com/IronExcavater/MediaExport" />
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </controls:EdgeFade>
    </Grid>
</Page>
