<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
        
        <StackPanel Spacing="5">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
            
            <TextBlock Text="Appearence" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <!-- Theme -->
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <FontIcon Grid.Column="0" Glyph="&#xE790;" Margin="0,0,16,0"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="Theme"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Column="2"
                        Width="140"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="settings:ThemeOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Tools" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Auto Update" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="YT-DLP" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="YT-DLP" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="YT-DLP" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
