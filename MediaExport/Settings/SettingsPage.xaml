<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
        
        <StackPanel Spacing="5">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
            <TextBlock Text="Appearence" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <FontIcon Grid.Column="0" Glyph="&#xE790;" Margin="0,0,16,0"/>

                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Themes" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>

                    <!-- Control on the right (e.g., ComboBox or ToggleSwitch) -->
                    <ComboBox Grid.Column="2" SelectedIndex="0" Width="100">
                        <ComboBoxItem>System</ComboBoxItem>
                        <ComboBoxItem>Dark</ComboBoxItem>
                        <ComboBoxItem>Light</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
