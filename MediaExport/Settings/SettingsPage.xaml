<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MediaExport.Controls"
    xmlns:settings="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="GroupActionStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="112" />
        </Style>
        <Style x:Key="ToolActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="144" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />            
        </Style>
        <Style x:Key="DividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        </Style>
    </Page.Resources>

    <!-- Keeping the gutter at all times stops the centred settings from shifting when the scroll bar appears. -->
    <Grid MaxWidth="1000">
        <controls:EdgeFade>
            <ScrollViewer controls:ScrollBarGutter.Mode="Stable">
                <StackPanel Padding="24,0,24,32" Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Appearance" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Theme" />
                                <ComboBox
                                    Grid.Column="2"
                                    Width="160"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Theme"
                                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ThemeOption">
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <FontIcon Width="18" VerticalAlignment="Center" FontSize="14" Glyph="{x:Bind Glyph}" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Tools" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingsIconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Automatically update tools installed by MediaExport" />
                                <ToggleSwitch
                                    Grid.Column="2"
                                    MinWidth="0"
                                    AutomationProperties.Name="Automatically update tools installed by MediaExport"
                                    IsOn="{x:Bind ViewModel.AutoUpdate, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </Border>
                    </Border>

                    <!-- The group actions live with the tool list, rather than beside the section heading. -->
                    <Expander
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        CornerRadius="8"
                        IsExpanded="True"
                        MinHeight="65">
                        <Expander.Header>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE74C;" Style="{StaticResource SettingsIconStyle}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Installed tools" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        Command="{x:Bind ViewModel.RefreshToolsCommand}"
                                        Style="{StaticResource GroupActionStyle}"
                                        ToolTipService.ToolTip="Look for each tool again">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                            <TextBlock VerticalAlignment="Center" Text="Refresh" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Command="{x:Bind ViewModel.OpenToolsFolderCommand}"
                                        Style="{StaticResource GroupActionStyle}"
                                        ToolTipService.ToolTip="Open the folder where MediaExport installs tools">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="&#xE838;" />
                                            <TextBlock VerticalAlignment="Center" Text="Open folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <ItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind ViewModel.Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:ToolViewModel">
                                    <Border Style="{StaticResource SettingsRowStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="20">
                                                <ProgressRing
                                                    Width="16"
                                                    Height="16"
                                                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                    Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Glyph="&#xEC61;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                    Glyph="&#xE7BA;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                                <FontIcon
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Glyph="&#xEA39;"
                                                    Style="{StaticResource SettingsIconStyle}"
                                                    Visibility="{x:Bind HasError, Mode=OneWay}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" MinHeight="38" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind StatusText, Mode=OneWay}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind SourceText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap"
                                                    AutomationProperties.HelpText="{x:Bind PathText, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind PathText, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- The same direct actions as the MVP: there is no overflow menu. -->
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    Margin="0,0,4,0"
                                                    Command="{x:Bind InstallCommand}"
                                                    Content="{x:Bind InstallActionText, Mode=OneWay}"
                                                    Style="{StaticResource ToolActionButtonStyle}"
                                                    Visibility="{x:Bind CanInstall, Mode=OneWay}" />
                                                <Button
                                                    Margin="0,0,4,0"
                                                    Command="{x:Bind UpdateCommand}"
                                                    Content="Update"
                                                    Style="{StaticResource ToolActionButtonStyle}"
                                                    ToolTipService.ToolTip="Update the copy MediaExport installed"
                                                    Visibility="{x:Bind CanUpdate, Mode=OneWay}" />
                                                <Button
                                                    AutomationProperties.Name="Website"
                                                    Click="Link_Click"
                                                    Style="{StaticResource ToolIconButtonStyle}"
                                                    Tag="{x:Bind Website}"
                                                    ToolTipService.ToolTip="Website">
                                                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="Source code"
                                                    Click="Link_Click"
                                                    Style="{StaticResource ToolIconButtonStyle}"
                                                    Tag="{x:Bind SourceCode}"
                                                    ToolTipService.ToolTip="Source code">
                                                    <FontIcon FontSize="14" Glyph="&#xE943;" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.HelpText="{x:Bind RemoveTip, Mode=OneWay}"
                                                    AutomationProperties.Name="Remove"
                                                    Command="{x:Bind RemoveCommand}"
                                                    Style="{StaticResource ToolIconButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind RemoveTip, Mode=OneWay}"
                                                    Visibility="{x:Bind CanRemove, Mode=OneWay}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="History" />
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <Border BorderThickness="0" Style="{StaticResource SettingsRowStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE74D;" Style="{StaticResource SettingsIconStyle}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Clear all history" />
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,8"
                                    Command="{x:Bind ViewModel.ClearAllHistoryCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasAnyHistory, Mode=OneWay}"
                                    ToolTipService.ToolTip="Clear the searches, the opened media and the finished exports together">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="Clear all" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" Style="{StaticResource SettingsIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Recent searches" />
                                </StackPanel>
                                <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearRecentSearchesCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasRecentSearches, Mode=OneWay}" />
                            </Grid>
                            <Rectangle Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B2;" Style="{StaticResource SettingsIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Recently opened media" />
                                </StackPanel>
                                <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearRecentMediaCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasRecentMedia, Mode=OneWay}" />
                            </Grid>
                            <Rectangle Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Finished exports" />                                    
                                </StackPanel>
                                <Button
                            Grid.Column="2"
                            MinWidth="72"
                            Command="{x:Bind ViewModel.ClearExportHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasExportHistory, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="About" />
                    <Border Style="{StaticResource SettingsGroupStyle}"
                        Height="80">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="48"
                                Height="48"
                                Margin="10,0,0,0"
                                Source="ms-appx:///Assets/App/Square44x44Logo.scale-200.png" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock>
                                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.App.DisplayName}" />
                                    <Run Text=" " />
                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.App.Version}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.App.Contributors}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Margin="0,0,15,0">                          
                                <Button
                                    AutomationProperties.Name="Report a problem"
                                    Click="Link_Click"
                                    Style="{StaticResource ToolIconButtonStyle}"
                                    Tag="{x:Bind ViewModel.App.ReportIssueUri}"
                                    ToolTipService.ToolTip="Report a problem">
                                    <FontIcon FontSize="14" Glyph="&#xEBE8;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Source code"
                                    Click="Link_Click"
                                    Style="{StaticResource ToolIconButtonStyle}"
                                    Tag="{x:Bind ViewModel.App.SourceUri}"
                                    ToolTipService.ToolTip="Source code">
                                    <FontIcon FontSize="14" Glyph="&#xE943;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Licence"
                                    Click="Link_Click"
                                    Style="{StaticResource ToolIconButtonStyle}"
                                    Tag="{x:Bind ViewModel.App.LicenseUri}"
                                    ToolTipService.ToolTip="Licence">
                                    <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </controls:EdgeFade>
    </Grid>
</Page>
