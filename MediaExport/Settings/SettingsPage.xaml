<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MediaExport.Converters"
    xmlns:local="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SettingsHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,28,0,8" />
        </Style>
        <Style x:Key="SettingsIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <converters:PassThroughConverter x:Key="PassThrough" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- Centred at a readable width; the side columns take whatever's left over. -->
        <Grid Padding="24,0,24,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60*" MaxWidth="1000" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Spacing="4">

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Appearance" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource SettingsIconStyle}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="Theme" />
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="Theme"
                        ItemsSource="{x:Bind ViewModel.Themes}"
                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                        Style="{StaticResource SettingsComboBoxStyle}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Tools" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ToolViewModel">
                        <Grid Margin="0,0,0,4">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="20">
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xEC61;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsHealthy, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                        <FontIcon
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xEA39;"
                                            Style="{StaticResource SettingsIconStyle}"
                                            Visibility="{x:Bind HasError, Mode=OneWay}" />
                                    </Grid>

                                    <!-- Name and version first; where it came from, or what went wrong, underneath. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                VerticalAlignment="Bottom"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind VersionText, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="{x:Bind SourceText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind SourceText, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Margin="0,0,4,0"
                                            Command="{x:Bind InstallCommand}"
                                            Content="{x:Bind PrimaryAction, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{x:Bind HasPrimaryAction, Mode=OneWay}" />
                                        <DropDownButton
                                            AutomationProperties.Name="Choose a version"
                                            Content="Versions"
                                            IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                            ToolTipService.ToolTip="Install any released version">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout Opening="Versions_Opening" Placement="BottomEdgeAlignedRight" />
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <Button
                                            AutomationProperties.Name="Website"
                                            Click="Link_Click"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind Website}"
                                            ToolTipService.ToolTip="Website"
                                            Visibility="{x:Bind HasWebsite}">
                                            <FontIcon FontSize="16" Glyph="&#xE774;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Source code"
                                            Click="Link_Click"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind SourceCode}"
                                            ToolTipService.ToolTip="Source code">
                                            <FontIcon FontSize="16" Glyph="&#xE943;" />
                                        </Button>
                                        <Button
                                            AutomationProperties.Name="Remove"
                                            Command="{x:Bind RemoveCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Remove the copy MediaExport installed"
                                            Visibility="{x:Bind IsManaged, Mode=OneWay}">
                                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Over the card's bottom edge while installing, so the card doesn't change size. -->
                            <ProgressBar
                                Margin="8,0,8,1"
                                VerticalAlignment="Bottom"
                                IsIndeterminate="{x:Bind converters:Show.Not(IsProgressKnown), Mode=OneWay}"
                                Visibility="{x:Bind IsWorking, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="Signing in" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE77B;" Style="{StaticResource SettingsIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Sign in with a browser" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="For videos that need an account, such as age-restricted ones" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        AutomationProperties.Name="Browser to sign in with"
                        ItemsSource="{x:Bind ViewModel.Browsers}"
                        SelectedItem="{x:Bind ViewModel.SelectedBrowser, Mode=TwoWay, Converter={StaticResource PassThrough}}"
                        Style="{StaticResource SettingsComboBoxStyle}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="History" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" Style="{StaticResource SettingsIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Recently opened media" />
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearSearchHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasSearchHistory, Mode=OneWay}" />
                    </Grid>
                    <Rectangle Style="{StaticResource DividerStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource SettingsIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Finished exports" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="The exported files are kept" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.ClearExportHistoryCommand}"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.HasExportHistory, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsHeaderStyle}" Text="About" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="48"
                        Height="48"
                        Source="ms-appx:///Assets/App/Square44x44Logo.targetsize-256_altform-unplated.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock>
                            <Run FontWeight="SemiBold" Text="MediaExport" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Version}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="By Niclas Rogulski, Andrew Shillabeer and Ezekiel Paterno" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button Click="Link_Click" Tag="https://github.com/IronExcavater/MediaExport">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE943;" />
                                <TextBlock Text="Source code" />
                            </StackPanel>
                        </Button>
                        <Button Click="Link_Click" Tag="https://github.com/IronExcavater/MediaExport/issues/new">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEBE8;" />
                                <TextBlock Text="Report a problem" />
                            </StackPanel>
                        </Button>
                        <Button Click="Link_Click" Tag="https://github.com/IronExcavater/MediaExport/blob/main/LICENSE">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                <TextBlock Text="Licence" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
