<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MediaExport.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:MediaExport.Settings"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
        
        <StackPanel Spacing="5">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
            
            <TextBlock Text="Appearence" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <!-- Theme -->
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <FontIcon Grid.Column="0" Glyph="&#xE790;" Margin="0,0,16,0"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="Theme"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Column="2"
                        Width="140"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="settings:ThemeOption">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Tools" Style="{StaticResource SettingsGroupTitleStyle}"/>
            <Border Style="{StaticResource SettingsItemStyle}">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE896;" Margin="0,0,16,0"/>
                    
                    <!-- Title and Description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Auto Update" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                    </StackPanel>

                    <ToggleSwitch 
                        Grid.Column="2" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="ToggleSwitch" 
                        Margin="0,0,0,0"/>
                </Grid>
            </Border>

            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True"
                ExpandDirection="Down"
                MinHeight="70">
                <Expander.Header>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="1"
                            Text="Installed Tools"
                            VerticalAlignment="Center" />

                        <Button Grid.Column="2"
                            Content="Update All"
                            MinWidth="110"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE896;" Margin="0,0,16,0"/>

                        <!-- Title and Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="yt-dlp" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Download"/>
                    </Grid>
                    
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE896;" Margin="0,0,16,0"/>

                        <!-- Title and Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ffmpeg" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Download"/>
                    </Grid>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE896;" Margin="0,0,16,0"/>

                        <!-- Title and Description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fprobe" Style="{StaticResource SettingsItemDescriptionStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="Download"/>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</Page>
