root = true

[*.{cs,vb}]
file_header_template = Copyright (C) 2026 Niclas Rogulski, Andrew Shillabeer, Ezekiel Paterno. All rights reserved.\nSPDX-License-Identifier: MPL-2.0
dotnet_diagnostic.IDE0073.severity = warning

[*.cs]
# Use var for every local variable; the type is on the right-hand side or in the name.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
