<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaExport.Core\MediaExport.Core.csproj" />
    <!-- View models are plain C#, so they're tested without the WinUI app. -->
    <Compile Include="..\MediaExport\Search\SearchViewModel.cs" Link="Linked\SearchViewModel.cs" />
    <Compile Include="..\MediaExport\Search\SearchDraft.cs" Link="Linked\SearchDraft.cs" />
    <Compile Include="..\MediaExport\Search\ResultsViewModel.cs" Link="Linked\ResultsViewModel.cs" />
    <Compile Include="..\MediaExport\Export\ExportViewModel.cs" Link="Linked\ExportViewModel.cs" />
    <Compile Include="..\MediaExport\Export\Choice.cs" Link="Linked\Choice.cs" />
    <Compile Include="..\MediaExport\Converters\Format.cs" Link="Linked\Format.cs" />
    <Compile Include="..\MediaExport\Activity\ExportJob.cs" Link="Linked\ExportJob.cs" />
    <Compile Include="..\MediaExport\Activity\ActivityViewModel.cs" Link="Linked\ActivityViewModel.cs" />
    <Compile Include="..\MediaExport\Settings\ToolViewModel.cs" Link="Linked\ToolViewModel.cs" />
    <Compile Include="..\MediaExport\Settings\BrowserCatalog.cs" Link="Linked\BrowserCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
